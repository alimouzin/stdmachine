<Application x:Class="Hmi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hmi.ViewModels"
             xmlns:views="clr-namespace:Hmi.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Une page = un ViewModel ; la vue correspondante est choisie ici. -->
            <DataTemplate DataType="{x:Type vm:MachinePageViewModel}"><views:MachinePageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StationPageViewModel}"><views:StationPageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrdersPageViewModel}"><views:OrdersPageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersPageViewModel}"><views:UsersPageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatsPageViewModel}"><views:StatsPageView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

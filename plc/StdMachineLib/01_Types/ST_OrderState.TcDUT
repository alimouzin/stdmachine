<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_OrderState" Id="{16865b56-7be2-58dc-b159-5035efc5bbbd}">
    <Declaration><![CDATA[// OF dans la table du séquenceur général (docs/05 § 5.6)
{attribute 'pack_mode' := '1'}
TYPE ST_OrderState :
STRUCT
    nOrder : UDINT;                 // n° interne, 0 = libre
    eState : E_OrderState;
    sNumber : STRING(40);
    sReference : STRING(40);
    nQuantity : UDINT;
    nGood : UDINT;
    nBad : UDINT;
    nInProcess : UDINT;
    aParam : ARRAY[1..GVL_Const.MAX_ORDER_PARAMS] OF LREAL;
    stQuality : ST_QualityTrack;    // budget de rebuts de l'OF (docs/10 § 4.3)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

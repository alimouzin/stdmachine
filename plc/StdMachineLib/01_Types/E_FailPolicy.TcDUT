  <DUT Name="E_FailPolicy" Id="{38cbfb84-4845-503e-b219-25bd48200fe9}">
    <Declaration><![CDATA[// Politique d'échec d'une instruction Action (docs/05 § 3.6)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_FailPolicy :
(
    StopStation := 0,
    Retry := 1,
    PartBad := 2,
    Goto := 3,
    Ignore := 4
) USINT;
END_TYPE
]]></Declaration>
  </DUT>

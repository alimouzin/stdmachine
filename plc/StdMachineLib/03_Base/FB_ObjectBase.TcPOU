    <Method Name="_IsMotion" Id="{2dd126ac-60a0-5ebb-8aea-c4fe3dd4c156}">
      <Declaration><![CDATA[METHOD PROTECTED _IsMotion : BOOL
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsMotion := _stInfo.nType <= GVL_Const.MAX_TYPE AND_THEN F_CatalogBit(GVL_Catalog.aMotionMask[_stInfo.nType], nAction);
]]></ST>
      </Implementation>
    </Method>

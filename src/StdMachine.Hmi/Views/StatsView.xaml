<UserControl x:Class="StdMachine.Hmi.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             Background="{StaticResource Bg.App}">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Statistiques" Style="{StaticResource Type.PageTitle}" Margin="0,0,0,12"/>
        <Border Grid.Row="1" Style="{StaticResource PageCard}">
            <c:EmptyState IconName="monitoring" Title="Statistiques de production" Message="À définir. Les données d'OF et de traçabilité sont déjà enregistrées."/>
        </Border>
    </Grid>
</UserControl>

    <Method Name="_DefaultTimeoutMs" Id="{044eadc0-f7de-59a1-899d-652575a10d27}">
      <Declaration><![CDATA[METHOD PROTECTED _DefaultTimeoutMs : UDINT
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _stInfo.nType <= GVL_Const.MAX_TYPE AND nAction >= 1 AND nAction <= GVL_Const.MAX_ACTION THEN
    _DefaultTimeoutMs := GVL_Catalog.aDefaultTimeoutMs[_stInfo.nType, nAction];
ELSE
    _DefaultTimeoutMs := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>

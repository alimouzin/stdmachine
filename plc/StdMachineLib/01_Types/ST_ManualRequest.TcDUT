<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ManualRequest" Id="{9c4031e2-42bb-5078-8b03-d55c0e3ad01d}">
    <Declaration><![CDATA[// Demande du canal manuel (docs/05 § 7)
{attribute 'pack_mode' := '1'}
TYPE ST_ManualRequest :
STRUCT
    nSeq : UDINT;
    eKind : E_ManualKind;
    nObject : UINT;                 // n° local
    nAction : UINT;
    stParams : ST_ActParams;        // résolus par la HMI
    nTeachPos : INT;                // position nommée à apprendre
    nTeachMask : USINT;             // bits X, Y, Z, C
    aTeachFrom : ARRAY[1..4] OF UINT;   // objets qui fournissent X, Y, Z, C
    sUser : STRING(24);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

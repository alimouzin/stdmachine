<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:th="clr-namespace:StdMachine.Hmi.Theme">

    <!-- docs/08 § 2 : seul fichier où figurent des valeurs de couleur, taille, rayon et durée. -->

    <!-- ===== 2.1 Neutres et accent ===== -->
    <Color x:Key="Bg.App.Color">#F4F5F7</Color>
    <SolidColorBrush x:Key="Bg.App" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="Bg.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="Bg.Sunken" Color="#F0F2F4"/>
    <SolidColorBrush x:Key="Border.Default" Color="#E1E4E8"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#D9DDE2"/>
    <SolidColorBrush x:Key="Border.Divider" Color="#EEF0F2"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#1A1D21"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#5F6873"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8A929C"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#B0B6BD"/>
    <SolidColorBrush x:Key="Text.OnColor" Color="#FFFFFF"/>
    <Color x:Key="Accent.Color">#2563C9</Color>
    <SolidColorBrush x:Key="Accent" Color="#2563C9"/>
    <SolidColorBrush x:Key="Accent.Pressed" Color="#1A4B9C"/>
    <SolidColorBrush x:Key="Accent.Bg" Color="#E9F0FB"/>
    <SolidColorBrush x:Key="Accent.BgSoft" Color="#F5F8FD"/>
    <SolidColorBrush x:Key="Accent.Border" Color="#9DB7E3"/>
    <SolidColorBrush x:Key="Scrim" Color="#661A1D21"/>

    <!-- ===== 2.2 Couleurs sémantiques (texte / fond / point) ===== -->
    <SolidColorBrush x:Key="Ok.Text" Color="#1E7A45"/>
    <SolidColorBrush x:Key="Ok.Bg" Color="#E5F3EA"/>
    <SolidColorBrush x:Key="Ok.Dot" Color="#1E8A4C"/>
    <Color x:Key="Ok.Dot.Color">#1E8A4C</Color>
    <SolidColorBrush x:Key="Warn.Text" Color="#8A5200"/>
    <SolidColorBrush x:Key="Warn.Bg" Color="#FCF0DB"/>
    <SolidColorBrush x:Key="Warn.Dot" Color="#D98A00"/>
    <Color x:Key="Warn.Dot.Color">#D98A00</Color>
    <SolidColorBrush x:Key="Err.Text" Color="#A83232"/>
    <SolidColorBrush x:Key="Err.Bg" Color="#FBE8E8"/>
    <SolidColorBrush x:Key="Err.Dot" Color="#C63C3C"/>
    <Color x:Key="Err.Dot.Color">#C63C3C</Color>
    <SolidColorBrush x:Key="Busy.Text" Color="#1A4B9C"/>
    <SolidColorBrush x:Key="Busy.Bg" Color="#E9F0FB"/>
    <SolidColorBrush x:Key="Busy.Dot" Color="#2563C9"/>
    <Color x:Key="Busy.Dot.Color">#2563C9</Color>
    <SolidColorBrush x:Key="Sim.Text" Color="#5B3CB0"/>
    <SolidColorBrush x:Key="Sim.Bg" Color="#EFEAFB"/>
    <SolidColorBrush x:Key="Sim.Dot" Color="#6D4AC9"/>
    <SolidColorBrush x:Key="Step.Text" Color="#0F5F59"/>
    <SolidColorBrush x:Key="Step.Bg" Color="#E0F2F1"/>
    <SolidColorBrush x:Key="Step.Dot" Color="#0F766E"/>
    <SolidColorBrush x:Key="Maint.Text" Color="#1E4E8C"/>
    <SolidColorBrush x:Key="Maint.Bg" Color="#E3EDFB"/>
    <SolidColorBrush x:Key="Maint.Dot" Color="#3A6FD8"/>
    <SolidColorBrush x:Key="Neutral.Text" Color="#3B424B"/>
    <SolidColorBrush x:Key="Neutral.Bg" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="Neutral.Dot" Color="#8A929C"/>
    <!-- Accent comme ton (texte accent sur fond accent clair) -->
    <SolidColorBrush x:Key="Accent.Text" Color="#1A4B9C"/>
    <SolidColorBrush x:Key="Accent.Dot" Color="#2563C9"/>

    <!-- ===== 2.4 Balise (couleurs physiques) ===== -->
    <SolidColorBrush x:Key="Beacon.Red" Color="#E5484D"/>
    <SolidColorBrush x:Key="Beacon.Orange" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Beacon.Green" Color="#22A55B"/>
    <SolidColorBrush x:Key="Beacon.Blue" Color="#2F6FED"/>
    <SolidColorBrush x:Key="Beacon.Off" Color="#D5D9DE"/>
    <Color x:Key="Beacon.Red.Color">#E5484D</Color>
    <Color x:Key="Beacon.Orange.Color">#F59E0B</Color>
    <Color x:Key="Beacon.Green.Color">#22A55B</Color>
    <Color x:Key="Beacon.Blue.Color">#2F6FED</Color>

    <!-- ===== 2.5 Typographie ===== -->
    <FontFamily x:Key="Font.Sans">pack://application:,,,/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Font.Icons">pack://application:,,,/Fonts/#Material Symbols Outlined</FontFamily>

    <sys:Double x:Key="FontSize.Caps">12</sys:Double>
    <sys:Double x:Key="FontSize.Caption">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.PageTitle">26</sys:Double>
    <sys:Double x:Key="FontSize.Value">34</sys:Double>
    <sys:Double x:Key="FontSize.Kpi">48</sys:Double>

    <Style x:Key="Type.Caps" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caps}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
    </Style>
    <Style x:Key="Type.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
    </Style>
    <Style x:Key="Type.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Type.BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Type.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Type.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Type.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Value}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Type.Kpi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Kpi}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>

    <!-- ===== 2.6 Dimensions, espacements, formes ===== -->
    <sys:Double x:Key="Size.Touch">48</sys:Double>
    <sys:Double x:Key="Size.Row">56</sys:Double>
    <sys:Double x:Key="Size.Command">64</sys:Double>
    <sys:Double x:Key="Size.NavItem">72</sys:Double>
    <sys:Double x:Key="Size.TopBar">64</sys:Double>
    <sys:Double x:Key="Size.NavRail">88</sys:Double>
    <GridLength x:Key="Size.NavRail.Length">88</GridLength>
    <sys:Double x:Key="Size.SidePanel">380</sys:Double>
    <GridLength x:Key="Size.SidePanel.Length">380</GridLength>
    <GridLength x:Key="Size.SidePanelLeft.Length">300</GridLength>
    <GridLength x:Key="Size.Palette.Length">280</GridLength>
    <sys:Double x:Key="Size.SidePanelLeft">300</sys:Double>
    <sys:Double x:Key="Size.Drawer">480</sys:Double>
    <sys:Double x:Key="Size.Keypad.Key">72</sys:Double>
    <sys:Double x:Key="Size.Keyboard.Key">64</sys:Double>
    <sys:Double x:Key="Size.Toggle.W">52</sys:Double>
    <sys:Double x:Key="Size.Toggle.H">32</sys:Double>
    <sys:Double x:Key="Size.Icon">24</sys:Double>
    <sys:Double x:Key="Size.Icon.Command">28</sys:Double>

    <CornerRadius x:Key="Radius.S">6</CornerRadius>
    <CornerRadius x:Key="Radius.M">8</CornerRadius>
    <CornerRadius x:Key="Radius.L">10</CornerRadius>
    <CornerRadius x:Key="Radius.XL">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <sys:Double x:Key="RadiusValue.S">6</sys:Double>
    <sys:Double x:Key="RadiusValue.M">8</sys:Double>
    <sys:Double x:Key="RadiusValue.L">10</sys:Double>
    <sys:Double x:Key="RadiusValue.XL">12</sys:Double>

    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.06" Color="#141E2D"/>
    <DropShadowEffect x:Key="Shadow.Raised" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.10" Color="#141E2D"/>
    <DropShadowEffect x:Key="Shadow.Overlay" BlurRadius="32" ShadowDepth="12" Direction="270" Opacity="0.16" Color="#141E2D"/>

    <!-- ===== 2.7 Mouvement ===== -->
    <Duration x:Key="Motion.Fast">0:0:0.120</Duration>
    <Duration x:Key="Motion.Base">0:0:0.200</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.320</Duration>
    <Duration x:Key="Pulse.Period">0:0:1.600</Duration>
    <sys:Double x:Key="Flow.Speed">40</sys:Double>
    <th:BezierEase x:Key="Ease.Standard" X1="0.2" Y1="0" X2="0" Y2="1"/>
</ResourceDictionary>

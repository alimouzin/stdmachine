<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>StdMachine.Hmi</RootNamespace>
    <AssemblyName>StdMachine.Hmi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Polices intégrées (IBM Plex Sans 400/500/600 et Material Symbols Outlined) -->
    <Resource Include="..\..\assets\fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <ProjectReference Include="..\StdMachine.Core\StdMachine.Core.csproj" />
    <ProjectReference Include="..\StdMachine.Simulation\StdMachine.Simulation.csproj" />
  </ItemGroup>
</Project>

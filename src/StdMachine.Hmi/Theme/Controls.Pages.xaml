<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Styles communs des pages (cartes, tableaux, lignes) : docs/08 § 2 et § 3 -->
    <Style x:Key="PageCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="TableHead" TargetType="TextBlock" BasedOn="{StaticResource Type.Caps}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TableRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border.Divider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="56"/>
    </Style>

    <Style x:Key="TableCell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="TableCellMuted" TargetType="TextBlock" BasedOn="{StaticResource TableCell}">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
</ResourceDictionary>

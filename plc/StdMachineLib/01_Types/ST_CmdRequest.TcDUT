<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CmdRequest" Id="{04793cc9-f69b-5c2d-bec9-83cecbf235ee}">
    <Declaration><![CDATA[// Commande d'état (docs/06 § 6.2) ; nTarget 0 = machine, 1..16 = station
{attribute 'pack_mode' := '1'}
TYPE ST_CmdRequest :
STRUCT
    nSeq : UDINT;
    nTarget : USINT;
    eCmd : E_Cmd;
    bSetMode : BOOL;                // changement de mode au lieu d'une commande
    eMode : E_Mode;
    sUser : STRING(24);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

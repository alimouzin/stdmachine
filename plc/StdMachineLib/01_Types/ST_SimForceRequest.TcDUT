<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_SimForceRequest" Id="{8388f125-b57a-5a0a-9477-86d8c4634b8f}">
    <Declaration><![CDATA[// Forcer une entrée d'un objet simulé (docs/04 § 6.3), Maintenance
{attribute 'pack_mode' := '1'}
TYPE ST_SimForceRequest :
STRUCT
    nSeq : UDINT;
    nStation : USINT;
    nObject : UINT;
    nSignal : USINT;                // S1..S8
    fValue : LREAL;
    bRelease : BOOL;                // faux = forcer, vrai = rendre la main à la simulation
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

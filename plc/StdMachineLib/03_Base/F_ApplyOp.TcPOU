<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="F_ApplyOp" Id="{289a2e97-1c67-59f6-89cb-c5a076bd2dc5}" SpecialFunc="None">
    <Declaration><![CDATA[// SetVar : 0 affecter, 1 ajouter, 2 soustraire (docs/06 § 3)
FUNCTION F_ApplyOp : LREAL
VAR_INPUT
    fCurrent : LREAL;
    fValue : LREAL;
    nOp : DINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE nOp OF
    1: F_ApplyOp := fCurrent + fValue;
    2: F_ApplyOp := fCurrent - fValue;
ELSE
    F_ApplyOp := fValue;
END_CASE
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_Interlock" Id="{1bd651e1-c822-5d7f-bc6b-6eeef317988c}">
    <Declaration><![CDATA[// Verrouillage (docs/06 § 2)
{attribute 'pack_mode' := '1'}
TYPE ST_Interlock :
STRUCT
    nObject : UINT;             // objet protégé
    nActionMask : UDINT;        // bit n-1 = action n ; 0 = toutes les actions de mouvement
    nCond : INT;                // condition qui doit rester vraie
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

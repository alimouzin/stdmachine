STRUCT
    nSeq : UDINT;
    eCmd : E_DeployCmd;
    nCrcMachine : UDINT;
    aCrcStation : ARRAY[1..GVL_Const.MAX_STATIONS] OF UDINT;
    nCrcRecipes : UDINT;
    nInstrSetRequired : UINT;       // docs/02 § 7.3
    nCatalogRequired : UINT;
    sUser : STRING(24);
END_STRUCT
END_TYPE
]]></Declaration>

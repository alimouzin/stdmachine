<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ObjectBase" Id="{a78b2127-30b8-5c72-be85-52eed7f989b8}" SpecialFunc="None">
    <Declaration><![CDATA[// Base de tous les objets élémentaires (docs/04 § 7) : identité, contrat d'action, timeout recalculé par
// l'override, verrouillages, simulation, alarmes, compteurs de maintenance, publication de l'état.
// Les types dérivés redéfinissent les méthodes protégées « _… » ; les valeurs par défaut viennent du catalogue.
FUNCTION_BLOCK FB_ObjectBase IMPLEMENTS I_Object, I_Maintained
VAR
    _stInfo : ST_ObjectInfo;
    _refCfg : REFERENCE TO ST_ObjConfig;
    _ipParent : I_Node;
    _ipLocks : I_InterlockProvider;
    _ipAlarms : I_AlarmSink;
    _eState : E_ObjState := E_ObjState.NotInitialized;
    _eActStatus : E_ActStatus := E_ActStatus.Idle;
    _nAction : UINT;
    _stParams : ST_ActParams;
    _stResults : ST_ActResults;
    _stStatus : ST_ObjStatus;
    _bManual : BOOL;
    _fProgressMs : LREAL;           // temps d'action compté au prorata de l'override (actions de mouvement)
    _nTimeoutMs : UDINT;
    _fElapsedMs : LREAL;            // durée réelle de l'action
    _fEffOverride : LREAL := 100.0;
    _nErrorCode : UINT;
    _nSubCode : UDINT;
    _bInitialized : BOOL;           // posé par le type dérivé à la fin de son Init
    _eFaultSeverity : E_Severity := E_Severity.StationFault;
    _aForced : ARRAY[1..GVL_Const.MAX_SIGNALS] OF BOOL;     // simulation : entrée forcée par la HMI
    _aForcedValue : ARRAY[1..GVL_Const.MAX_SIGNALS] OF LREAL;
    _bNewObject : BOOL;             // Configure : l'élément de pool change d'objet (valeurs persistantes du type à remettre à zéro)
END_VAR
VAR PERSISTENT
    _nStableId : UDINT;             // objet du projet auquel appartiennent ces compteurs (D92)
    _nActionCount : UDINT;
    _nErrorCount : UDINT;
    _fMotionHours : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Configure" Id="{29ef38b2-324e-5cb9-9b86-4bb62ec9501e}">
      <Declaration><![CDATA[METHOD Configure : BOOL
VAR_INPUT
    refCfg : REFERENCE TO ST_ObjConfig;
    nStation : UINT;
    nPoolIndex : UINT;
    ipParent : I_Node;
    ipLocks : I_InterlockProvider;
    ipAlarms : I_AlarmSink;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_refCfg REF= refCfg;
_ipParent := ipParent;
_ipLocks := ipLocks;
_ipAlarms := ipAlarms;
_stInfo.nStation := nStation;
_stInfo.nLocalId := refCfg.nLocalId;
_stInfo.nParentId := refCfg.nParentId;
_stInfo.nType := refCfg.nType;
_stInfo.nPoolIndex := nPoolIndex;
_stInfo.nStableId := refCfg.nStableId;
_stInfo.sName := refCfg.sName;
_stInfo.nGlobalId := UINT_TO_UDINT(nStation) * 1000 + UINT_TO_UDINT(refCfg.nLocalId);
_eFaultSeverity := SEL(nStation = 0, E_Severity.StationFault, E_Severity.MachineFault);

// Un élément de pool repris par un autre objet repart de compteurs nuls (D92)
_bNewObject := _nStableId <> refCfg.nStableId;
IF _bNewObject THEN
    _nStableId := refCfg.nStableId;
    _nActionCount := 0;
    _nErrorCount := 0;
    _fMotionHours := 0;
END_IF

_eActStatus := E_ActStatus.Idle;
_nAction := 0;
_nErrorCode := 0;
_nSubCode := 0;
_bManual := FALSE;
_bInitialized := FALSE;
_fEffOverride := 100.0;
MEMSET(ADR(_aForced), 0, SIZEOF(_aForced));
MEMSET(ADR(_stResults), 0, SIZEOF(_stResults));

IF NOT _OnConfigure() THEN
    _eState := E_ObjState.Error;
    _nErrorCode := GVL_Catalog.Err_NotWired;
    Configure := FALSE;
    RETURN;
END_IF
IF refCfg.bDisabled THEN
    _eState := E_ObjState.Disabled;
ELSIF _NeedsInit() THEN
    _eState := E_ObjState.NotInitialized;
ELSE
    _eState := E_ObjState.Ready;
END_IF
Configure := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{ece6286b-5015-5191-b85a-07e58a10e464}">
      <Declaration><![CDATA[METHOD Start : E_StartResult
VAR_INPUT
    nAction : UINT;
    refParams : REFERENCE TO ST_ActParams;
    bManual : BOOL;
END_VAR
VAR
    nLock : INT;
    nCfgTimeout : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(_refCfg) THEN Start := E_StartResult.NotConfigured; RETURN; END_IF
IF _eState = E_ObjState.Disabled THEN Start := E_StartResult.Disabled; RETURN; END_IF
IF _eState = E_ObjState.Busy THEN Start := E_StartResult.Busy; RETURN; END_IF
IF NOT F_CatalogHasAction(_stInfo.nType, nAction) THEN Start := E_StartResult.UnknownAction; RETURN; END_IF
IF _IsManualOnly(nAction) AND NOT bManual THEN Start := E_StartResult.ManualOnly; RETURN; END_IF
IF _eState = E_ObjState.Error THEN Start := E_StartResult.NotReady; RETURN; END_IF
IF _eState = E_ObjState.NotInitialized AND NOT _IsAllowedNotInit(nAction) THEN
    Start := E_StartResult.NotReady;
    RETURN;
END_IF

_stParams := refParams;
IF NOT _ValidateParams(nAction) THEN Start := E_StartResult.BadParam; RETURN; END_IF

IF _ipLocks <> 0 THEN
    nLock := _ipLocks.Check(_stInfo.nLocalId, nAction);
    IF nLock <> 0 THEN
        _stStatus.nInterlock := INT_TO_USINT(nLock);
        Start := E_StartResult.Interlocked;
        RETURN;
    END_IF
END_IF
_stStatus.nInterlock := 0;

// Acceptée
_nAction := nAction;
_bManual := bManual;
_fProgressMs := 0;
_fElapsedMs := 0;
IF nAction <= GVL_Const.MAX_ACTION_TIMEOUTS THEN nCfgTimeout := _refCfg.aTimeoutMs[nAction]; ELSE nCfgTimeout := 0; END_IF
IF _stParams.nTimeoutMs > 0 THEN
    _nTimeoutMs := _stParams.nTimeoutMs;
ELSIF nCfgTimeout > 0 THEN
    _nTimeoutMs := nCfgTimeout;
ELSE
    _nTimeoutMs := _DefaultTimeoutMs(nAction);
END_IF
MEMSET(ADR(_stResults), 0, SIZEOF(_stResults));
_nErrorCode := 0;
_nSubCode := 0;
_nActionCount := _nActionCount + 1;
_eState := E_ObjState.Busy;
_eActStatus := _OnStart(nAction);       // Busy, ou Done / Error immédiat
IF _eActStatus <> E_ActStatus.Busy THEN
    _EndAction();
END_IF
Start := E_StartResult.Accepted;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cycle" Id="{4c296993-f08f-575b-abe4-0860a6c144e5}">
      <Declaration><![CDATA[METHOD Cycle
VAR
    fCycleMs : LREAL;
    fParentOv : LREAL;
    nLock : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(_refCfg) THEN RETURN; END_IF
fCycleMs := F_CycleMs();

// 1. Override effectif : les parents sont appelés avant leurs enfants (docs/04 § 8)
fParentOv := 100.0;
IF _ipParent <> 0 THEN fParentOv := _ipParent.EffectiveOverride; END_IF
_fEffOverride := fParentOv * LIMIT(0.0, _refCfg.fOverride, 100.0) / 100.0;
IF _bManual AND _eState = E_ObjState.Busy THEN
    _fEffOverride := _fEffOverride * _ManualOverride() / 100.0;
END_IF
_ApplyOverride(_fEffOverride);

// 2. Entrées
IF _IsSimulated() THEN _Simulate(); ELSE _ReadHw(); END_IF

// 3. Action en cours
IF _eState = E_ObjState.Busy THEN
    _fElapsedMs := _fElapsedMs + fCycleMs;
    IF _IsMotion(_nAction) THEN
        _fProgressMs := _fProgressMs + fCycleMs * _fEffOverride / 100.0;
        _fMotionHours := _fMotionHours + fCycleMs / 3600000.0;
        IF _ipLocks <> 0 THEN
            nLock := _ipLocks.Check(_stInfo.nLocalId, _nAction);
            IF nLock <> 0 THEN
                _OnAbort(_nAction);
                _stStatus.nInterlock := INT_TO_USINT(nLock);
                _Fail(GVL_Catalog.Err_Interlocked, INT_TO_UDINT(nLock));
            END_IF
        END_IF
    ELSE
        _fProgressMs := _fProgressMs + fCycleMs;
    END_IF
    IF _eState = E_ObjState.Busy THEN
        _eActStatus := _OnCycle(_nAction);
        IF _eActStatus = E_ActStatus.Busy AND _nTimeoutMs > 0 AND _fProgressMs >= UDINT_TO_LREAL(_nTimeoutMs) THEN
            _OnAbort(_nAction);
            _Fail(GVL_Catalog.Err_Timeout, _nAction);
        ELSIF _eActStatus <> E_ActStatus.Busy THEN
            _EndAction();
        END_IF
    END_IF
END_IF

// 4. Surveillance continue
IF _eState <> E_ObjState.Disabled THEN _Monitor(); END_IF

// 5. Sorties
IF NOT _IsSimulated() THEN _WriteHw(); END_IF

// 6. Publication pour la HMI
_stStatus.eState := _eState;
_stStatus.eActStatus := _eActStatus;
_stStatus.nAction := UINT_TO_USINT(_nAction);
_stStatus.bManual := _bManual;
_stStatus.nErrorCode := _nErrorCode;
_stStatus.nSubCode := _nSubCode;
_stStatus.fEffOverride := LREAL_TO_REAL(_fEffOverride);
_stStatus.bOverrideHalted := (_eState = E_ObjState.Busy) AND _IsMotion(_nAction) AND (_fEffOverride <= 0.0);
_stStatus.bSimulated := _IsSimulated();
_stStatus.nElapsedMs := LREAL_TO_UDINT(_fElapsedMs);
_stStatus.nTimeoutMs := _EffectiveTimeoutEstimate();
_stStatus.nActionCount := _nActionCount;
_stStatus.nErrorCount := _nErrorCount;
_stStatus.fMotionHours := LREAL_TO_REAL(_fMotionHours);
_stStatus.fProgress := -1;
_Publish();                             // aValue[1..4], fProgress
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Abort" Id="{fc3486e7-62d0-568f-acec-2eb62720d592}">
      <Declaration><![CDATA[METHOD Abort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _eState = E_ObjState.Busy THEN
    _OnAbort(_nAction);
    _eActStatus := E_ActStatus.Error;
    _nErrorCode := GVL_Catalog.Err_Aborted;     // action interrompue par Abort : pas d'alarme levée
    _nSubCode := _nAction;
    _eState := SEL(_NeedsInit() AND NOT _bInitialized, E_ObjState.Ready, E_ObjState.NotInitialized);
END_IF
_SafeState();
IF _HardwareFault() AND _eState <> E_ObjState.Disabled THEN _eState := E_ObjState.Error; END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ack" Id="{370cd925-589a-5a1d-9e9e-b648bdcb8c66}">
      <Declaration><![CDATA[METHOD Ack : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _eState <> E_ObjState.Error THEN
    Ack := TRUE;
    RETURN;
END_IF
IF _OnAck() THEN
    IF _ipAlarms <> 0 AND _nErrorCode <> 0 THEN _ipAlarms.Clear(_stInfo.nGlobalId, _nErrorCode); END_IF
    _nErrorCode := 0;
    _nSubCode := 0;
    _eActStatus := E_ActStatus.Idle;
    _eState := SEL(_NeedsInit() AND NOT _bInitialized, E_ObjState.Ready, E_ObjState.NotInitialized);
    Ack := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ForceInput" Id="{2416ffa4-1bbb-5ee5-8d0c-7f77502ab7b9}">
      <Declaration><![CDATA[METHOD ForceInput
VAR_INPUT
    nSignal : USINT;
    fValue : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nSignal = 0 THEN
    MEMSET(ADR(_aForced), 0, SIZEOF(_aForced));
ELSIF nSignal <= GVL_Const.MAX_SIGNALS THEN
    _aForced[nSignal] := TRUE;
    _aForcedValue[nSignal] := fValue;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EffectiveOverride" Id="{2f03a8f9-b9bd-5c52-8eec-a0c2418a6629}">
      <Declaration><![CDATA[PROPERTY EffectiveOverride : LREAL
]]></Declaration>
      <Get Name="Get" Id="{54bfdd0e-9e8b-5dc0-8c9e-7da99a19177f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EffectiveOverride := _fEffOverride;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NodeState" Id="{4fdb81b2-946e-5130-916b-511215238537}">
      <Declaration><![CDATA[PROPERTY NodeState : E_ObjState
]]></Declaration>
      <Get Name="Get" Id="{5847fa26-c19e-5263-b638-599fd7fa80cf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[NodeState := _eState;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Info" Id="{ea62547f-8f85-540c-84bd-c58344400abc}">
      <Declaration><![CDATA[PROPERTY Info : REFERENCE TO ST_ObjectInfo
]]></Declaration>
      <Get Name="Get" Id="{ac8646a2-8e1d-51af-aa67-f8a40e13e57d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Info REF= _stInfo;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ActStatus" Id="{6c7639d1-02b1-5bfd-b37f-b7c7cb1ce33d}">
      <Declaration><![CDATA[PROPERTY ActStatus : E_ActStatus
]]></Declaration>
      <Get Name="Get" Id="{aaae9fa4-ac4d-557f-bc42-59c50d7b7cb8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ActStatus := _eActStatus;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Results" Id="{40f1580b-3567-5934-863e-b84d7bea3ba7}">
      <Declaration><![CDATA[PROPERTY Results : REFERENCE TO ST_ActResults
]]></Declaration>
      <Get Name="Get" Id="{83372f58-19b5-5e63-8ea6-b195f3d2cd09}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Results REF= _stResults;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Status" Id="{ec588d59-be51-5344-bd28-b9ee6138f87a}">
      <Declaration><![CDATA[PROPERTY Status : REFERENCE TO ST_ObjStatus
]]></Declaration>
      <Get Name="Get" Id="{0d8d7199-447b-5e0b-8434-bc7bbe73fa2c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Status REF= _stStatus;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StableId" Id="{9206849c-4e17-5068-a9f7-5745c678063e}">
      <Declaration><![CDATA[// ---------- Compteurs de maintenance (I_Maintained)
PROPERTY StableId : UDINT
]]></Declaration>
      <Get Name="Get" Id="{fd21c533-e1f2-585d-9f3e-b85fc31c2d12}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StableId := _nStableId;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ActionCount" Id="{8eef8d37-0377-5fe0-b83b-7d2b94fe52c5}">
      <Declaration><![CDATA[PROPERTY ActionCount : UDINT
]]></Declaration>
      <Get Name="Get" Id="{82868cde-0924-5972-95db-efbfd141bfd6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ActionCount := _nActionCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorCount" Id="{d26f6cef-9970-575a-b6be-534f7f7944b2}">
      <Declaration><![CDATA[PROPERTY ErrorCount : UDINT
]]></Declaration>
      <Get Name="Get" Id="{62f319d0-9150-5255-b625-99190648c066}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorCount := _nErrorCount;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MotionHours" Id="{0f014816-3002-5c85-b0af-36317e1a621f}">
      <Declaration><![CDATA[PROPERTY MotionHours : LREAL
]]></Declaration>
      <Get Name="Get" Id="{3e1a0591-229b-5d93-a871-1a624723a379}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MotionHours := _fMotionHours;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RestoreCounters" Id="{98fbc969-df36-5b82-b8d3-847c22bf8902}">
      <Declaration><![CDATA[// Restauration des valeurs sauvegardées par la HMI (docs/05 § 10, étape 6)
METHOD RestoreCounters
VAR_INPUT
    nActions : UDINT;
    nErrors : UDINT;
    fHours : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_nActionCount := nActions;
_nErrorCount := nErrors;
_fMotionHours := fHours;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_EndAction" Id="{98df1099-e7e1-5def-a562-c1fa242ae2db}">
      <Declaration><![CDATA[// ---------- Fin d'action et erreurs
METHOD PROTECTED _EndAction
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _eActStatus = E_ActStatus.Done THEN
    _eState := SEL(_NeedsInit() AND NOT _bInitialized, E_ObjState.Ready, E_ObjState.NotInitialized);
ELSIF _eActStatus = E_ActStatus.Error AND _eState <> E_ObjState.Error THEN
    _Fail(GVL_Catalog.Err_UnknownAction, _nAction);     // le type a répondu Error sans dire pourquoi
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Fail" Id="{f58c86b5-000b-5107-ac31-0e6d63559a55}">
      <Declaration><![CDATA[METHOD PROTECTED _Fail
VAR_INPUT
    nCode : UINT;
    nSubCode : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_eActStatus := E_ActStatus.Error;
_nErrorCode := nCode;
_nSubCode := nSubCode;
_eState := E_ObjState.Error;
_nErrorCount := _nErrorCount + 1;
IF _ipAlarms <> 0 THEN _ipAlarms.Raise(_stInfo.nGlobalId, nCode, nSubCode, _eFaultSeverity); END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SetResult" Id="{6640355c-ecf2-5581-928c-acf2f9801e45}">
      <Declaration><![CDATA[METHOD PROTECTED _SetResult
VAR_INPUT
    nIndex : USINT;
    fValue : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nIndex >= 1 AND nIndex <= GVL_Const.MAX_PARAMS THEN
    _stResults.aReal[nIndex] := fValue;
    _stResults.nCount := MAX(_stResults.nCount, nIndex);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SetJudgement" Id="{0c7a15bf-3a89-58e2-8194-7969fc3f2729}">
      <Declaration><![CDATA[METHOD PROTECTED _SetJudgement
VAR_INPUT
    nIndex : USINT;
    eJudgement : E_Judgement;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nIndex >= 1 AND nIndex <= GVL_Const.MAX_PARAMS THEN
    _stResults.aJudgement[nIndex] := eJudgement;
    _stResults.aReal[nIndex] := TO_LREAL(eJudgement);
    _stResults.nCount := MAX(_stResults.nCount, nIndex);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SetResultPos" Id="{bd6d0730-2d28-5bb7-ba78-b2acff591ca8}">
      <Declaration><![CDATA[METHOD PROTECTED _SetResultPos
VAR_INPUT
    nIndex : USINT;
    stPos : ST_Position;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stResults.stPos := stPos;
_stResults.nPosIndex := nIndex;
_stResults.nCount := MAX(_stResults.nCount, nIndex);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_IsSimulated" Id="{f0c87efb-8a3b-5a58-9e48-56edc2ca7f98}">
      <Declaration><![CDATA[// ---------- Aides
METHOD PROTECTED _IsSimulated : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsSimulated := GVL_Sim.bAllSimulated OR (__ISVALIDREF(_refCfg) AND_THEN _refCfg.bSimulated);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Forced" Id="{e32ea407-93db-5d3d-bd5c-0b46f13dc8be}">
      <Declaration><![CDATA[METHOD PROTECTED _Forced : BOOL
VAR_INPUT
    nSignal : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Forced := nSignal >= 1 AND nSignal <= GVL_Const.MAX_SIGNALS AND_THEN _aForced[nSignal];
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ForcedValue" Id="{806e7eb4-15d2-5121-a404-bde8cdb18a88}">
      <Declaration><![CDATA[METHOD PROTECTED _ForcedValue : LREAL
VAR_INPUT
    nSignal : USINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nSignal >= 1 AND nSignal <= GVL_Const.MAX_SIGNALS THEN _ForcedValue := _aForcedValue[nSignal]; END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Param" Id="{5b4e5289-b27b-5e1e-8560-7bb1ee254dee}">
      <Declaration><![CDATA[METHOD PROTECTED _Param : LREAL
VAR_INPUT
    nParam : USINT;              // P1..P24
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nParam >= 1 AND nParam <= GVL_Const.MAX_OBJ_PARAMS THEN _Param := _refCfg.aParam[nParam]; END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ParamReal" Id="{cca93a22-e8f1-51ca-8bb1-91a440edd275}">
      <Declaration><![CDATA[METHOD PROTECTED _ParamReal : LREAL
VAR_INPUT
    nParam : USINT;              // a1..a8
    fDefault : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nParam >= 1 AND nParam <= GVL_Const.MAX_PARAMS AND_THEN _stParams.aKind[nParam] <> E_ParamKind.Unused THEN
    _ParamReal := _stParams.aReal[nParam];
ELSE
    _ParamReal := fDefault;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_EffectiveTimeoutEstimate" Id="{073ea460-d8c5-58aa-aabf-1ac1ff79db88}">
      <Declaration><![CDATA[METHOD PROTECTED _EffectiveTimeoutEstimate : UDINT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _nTimeoutMs = 0 THEN
    _EffectiveTimeoutEstimate := 0;
ELSIF _IsMotion(_nAction) AND _fEffOverride <= 0.0 THEN
    _EffectiveTimeoutEstimate := 16#FFFFFFFF;          // « infini » à 0 %
ELSIF _IsMotion(_nAction) THEN
    _EffectiveTimeoutEstimate := LREAL_TO_UDINT(MIN(UDINT_TO_LREAL(_nTimeoutMs) * 100.0 / _fEffOverride, 86400000.0));
ELSE
    _EffectiveTimeoutEstimate := _nTimeoutMs;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnConfigure" Id="{60794253-a6a2-5804-b0d4-33a7ff372bde}">
      <Declaration><![CDATA[// ---------- Méthodes à redéfinir par les types (valeurs par défaut tirées du catalogue)
METHOD PROTECTED _OnConfigure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OnConfigure := TRUE;
]]></ST>
      </Implementation>
    </Method>

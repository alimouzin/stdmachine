<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_StationStatus" Id="{1173edd9-2e2c-51a2-bb26-8e11f6eee7db}">
    <Declaration><![CDATA[// Statut d'une station (docs/06 § 6.3)
{attribute 'pack_mode' := '1'}
TYPE ST_StationStatus :
STRUCT
    eState : E_State;
    eMode : E_Mode;
    fEffOverride : REAL;
    nBeacon : UINT;                 // voir F_BeaconBits
    bFault : BOOL;
    bOutOfProduction : BOOL;
    bQualityLock : BOOL;
    nOpGroup : USINT;
    nOpOperation : USINT;
    nOpMover : USINT;
    nOpSlot : USINT;
    eOpStatus : E_OpStatus;
    fOpElapsedMs : REAL;
    aCtx : ARRAY[1..GVL_Const.MAX_CTX] OF ST_CtxStatus;
    bStepEnabled : BOOL;
    eStepGranularity : E_StepGranularity;
    nCalib : USINT;
    aCalib : ARRAY[1..GVL_Const.CALIB_PER_STATION] OF ST_CalibStatus;
    stPrompt : ST_PromptState;
    nCycleCount : UDINT;
    fLastCycleMs : REAL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

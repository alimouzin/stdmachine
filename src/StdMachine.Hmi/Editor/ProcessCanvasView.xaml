<UserControl x:Class="StdMachine.Hmi.Editor.ProcessCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:ed="clr-namespace:StdMachine.Hmi.Editor"
             xmlns:dd="clr-namespace:StdMachine.Hmi.DragDrop"
             xmlns:core="clr-namespace:StdMachine.Core;assembly=StdMachine.Core"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <UserControl.Resources>
        <Style x:Key="PlacedAt" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        </Style>

        <!-- Ligne de paramètre : nom à gauche, valeur à droite -->
        <DataTemplate DataType="{x:Type ed:ParamLine}">
            <Grid Margin="0,0,0,2">
                <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="96"/>
                <TextBlock x:Name="V" Text="{Binding Value}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="112" Margin="60,0,0,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="V" Property="Foreground" Value="{StaticResource Err.Dot}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ed:TermLine}">
            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                <c:Icon x:Name="Ico" Glyph="close" FontSize="15" Foreground="{StaticResource Err.Dot}" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Warn.Text}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Satisfied}" Value="True">
                    <Setter TargetName="Ico" Property="Glyph" Value="check"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Ok.Dot}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Carte d'étape (docs/08 § 6.9 et § 7.2) -->
        <DataTemplate DataType="{x:Type ed:StepCardModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Border x:Name="Halo" CornerRadius="12" Margin="-4" BorderThickness="4" BorderBrush="#552563C9" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="Card" CornerRadius="9" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                        Effect="{StaticResource Shadow.Card}" dd:Drag.Source="{Binding Step}" Padding="12,9,12,8">
                    <DockPanel>
                        <c:ProgressStrip x:Name="Progress" DockPanel.Dock="Bottom" BarHeight="4" Margin="-12,6,-12,-8" Visibility="Collapsed" Value="{Binding Progress}"/>
                        <Border x:Name="Banner" DockPanel.Dock="Bottom" Margin="0,6,0,0" CornerRadius="6" Padding="8,5" Visibility="Collapsed" Background="{StaticResource Err.Bg}">
                            <DockPanel>
                                <c:Icon x:Name="BannerIcon" DockPanel.Dock="Left" Glyph="error" FontSize="16" Foreground="{StaticResource Err.Text}" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="BannerText" FontSize="11.5" Foreground="{StaticResource Err.Text}" TextWrapping="Wrap" MaxHeight="32"/>
                            </DockPanel>
                        </Border>
                        <Grid DockPanel.Dock="Bottom" Margin="0,5,0,0">
                            <Rectangle Height="1" Fill="{StaticResource Border.Divider}" VerticalAlignment="Top"/>
                            <DockPanel Margin="0,5,0,0">
                                <TextBlock x:Name="StateText" DockPanel.Dock="Right" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                <c:Icon Glyph="schedule" FontSize="14" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TimeText" Text="{Binding DurationText}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" Visibility="{Binding HasObject, Converter={x:Static infra:Conv.BoolToVis}}">
                                <c:Icon Glyph="{Binding ObjectIcon}" FontSize="15" Foreground="{StaticResource Accent.Text}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ObjectName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent.Text}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            </StackPanel>
                            <DockPanel>
                                <c:Icon DockPanel.Dock="Right" Glyph="{Binding Icon}" FontSize="17" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                                <Border x:Name="NumPill" DockPanel.Dock="Left" MinWidth="22" Height="20" CornerRadius="10" Background="#EEF0F3" Padding="5,0" VerticalAlignment="Top" Margin="0,0,7,0" dd:Drag.Handle="True">
                                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Neutral.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" LineHeight="16"/>
                                    <TextBlock x:Name="Sub" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Accent.Text}" FontWeight="Medium" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="ParamList" ItemsSource="{Binding Params}" Margin="0,6,0,0" Focusable="False" IsHitTestVisible="False"/>
                            <ItemsControl x:Name="TermList" ItemsSource="{Binding Terms}" Margin="0,2,0,0" Focusable="False" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="NextOutline" CornerRadius="9" BorderThickness="2" BorderBrush="{StaticResource Accent}" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Background>
                        <SolidColorBrush Color="Transparent"/>
                    </Border.Background>
                </Border>
                <Border x:Name="Tag" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,8,0" CornerRadius="9" Padding="8,1" Background="{StaticResource Accent}">
                    <TextBlock x:Name="TagText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                </Border>
                <Border x:Name="Check" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-7,0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Ok.Dot}" IsHitTestVisible="False">
                    <c:Icon Glyph="check" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Banner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BannerText" Property="Text" Value="{Binding ErrorMessage}"/>
                    <Setter TargetName="NumPill" Property="Background" Value="{StaticResource Err.Bg}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Err.Dot}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                    <Setter TargetName="Banner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Banner" Property="Background" Value="{StaticResource Warn.Bg}"/>
                    <Setter TargetName="BannerIcon" Property="Glyph" Value="warning"/>
                    <Setter TargetName="BannerIcon" Property="Foreground" Value="{StaticResource Warn.Text}"/>
                    <Setter TargetName="BannerText" Property="Text" Value="{Binding WarnMessage}"/>
                    <Setter TargetName="BannerText" Property="Foreground" Value="{StaticResource Warn.Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Card" Property="Effect" Value="{StaticResource Shadow.Raised}"/>
                    <Setter TargetName="NumPill" Property="Background" Value="{StaticResource Accent.Bg}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Halo" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                </DataTrigger>
                <!-- États d'exécution -->
                <DataTrigger Binding="{Binding State}" Value="Next">
                    <Setter TargetName="NextOutline" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TagText" Property="Text" Value="Suivante"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Halo" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StateText" Property="Text" Value="{Binding TimeText}"/>
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Accent.Text}"/>
                    <Setter TargetName="NumPill" Property="Background" Value="{StaticResource Accent.Bg}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Sub" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="WaitingCondition">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Warn.Dot}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Card" Property="Background" Value="#FFFDF8"/>
                    <Setter TargetName="StateText" Property="Text" Value="{Binding TimeText}"/>
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Warn.Text}"/>
                    <Setter TargetName="TermList" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tag" Property="Background" Value="{StaticResource Warn.Dot}"/>
                    <Setter TargetName="TagText" Property="Text" Value="En attente"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Retry">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Warn.Dot}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tag" Property="Background" Value="{StaticResource Warn.Dot}"/>
                    <Setter TargetName="TagText" Property="Text" Value="{Binding AttemptText}"/>
                    <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Progress" Property="Fill" Value="{StaticResource Warn.Dot}"/>
                    <Setter TargetName="StateText" Property="Text" Value="{Binding TimeText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StateText" Property="Text" Value="{Binding TimeText}"/>
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Ok.Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Err.Dot}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Err.Bg}"/>
                    <Setter TargetName="NumPill" Property="Background" Value="{StaticResource Err.Bg}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Err.Dot}"/>
                    <Setter TargetName="Banner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BannerText" Property="Text" Value="{Binding Detail}"/>
                    <Setter TargetName="StateText" Property="Text" Value="En erreur"/>
                    <Setter TargetName="ParamList" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Err.Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotTaken">
                    <Setter TargetName="Card" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Zone vide d'une branche -->
        <DataTemplate DataType="{x:Type ed:PlaceholderModel}">
            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="9" Background="#B3FFFFFF">
                <Border.BorderBrush>
                    <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#C3C9D0">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,4,4"/>
                                        <RectangleGeometry Rect="4,4,4,4"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1.5</Border.BorderThickness>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:Icon Glyph="add" FontSize="18" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,6,0"/>
                    <TextBlock Text="Déposez une action ici" FontSize="12" Foreground="{StaticResource Text.Tertiary}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="Scroller_ScrollChanged" SizeChanged="Scroller_SizeChanged">
        <Grid x:Name="Surface" Background="Transparent" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
            </Grid.LayoutTransform>

            <!-- Fond des couloirs -->
            <ItemsControl ItemsSource="{Binding Lanes}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Width}" Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                BorderBrush="#E6E9EC" BorderThickness="0,0,1,0" Background="Transparent"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cadres des blocs -->
            <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><StaticResource ResourceKey="PlacedAt"/></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ed:BlockFrameModel}">
                        <Rectangle x:Name="Frame" Width="{Binding Width}" Height="{Binding Height}" RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="5,3"
                                   Stroke="{StaticResource Accent.Border}" Fill="#80F5F8FD"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="If">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Border.Strong}"/>
                                <Setter TargetName="Frame" Property="Fill" Value="#59FFFFFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Repeat">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Warn.Dot}"/>
                                <Setter TargetName="Frame" Property="Fill" Value="#59FFF8E8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Frame" Property="StrokeDashArray" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Running">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Frame" Property="StrokeDashArray" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Frame" Property="Fill" Value="#33C7D9F5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Err.Dot}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connecteurs -->
            <ItemsControl ItemsSource="{Binding Connectors}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ed:ConnectorModel}">
                        <Path x:Name="P" Data="{Binding Data}" Stroke="#C3C9D0" StrokeThickness="1.6" StrokeLineJoin="Round" Loaded="Connector_Loaded"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Done">
                                <Setter TargetName="P" Property="Stroke" Value="{StaticResource Accent.Border}"/>
                                <Setter TargetName="P" Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Active">
                                <Setter TargetName="P" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="P" Property="StrokeThickness" Value="2.4"/>
                                <Setter TargetName="P" Property="StrokeDashArray" Value="3,3"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Zones vides -->
            <ItemsControl ItemsSource="{Binding Placeholders}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><StaticResource ResourceKey="PlacedAt"/></ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <!-- Titres de branches (Si / Sinon) -->
            <ItemsControl ItemsSource="{Binding BranchLabels}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ed:BranchLabelModel}">
                        <TextBlock x:Name="T" Text="{Binding Text}" Width="{Binding Width}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ok.Text}" TextTrimming="CharacterEllipsis"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsElse}" Value="True">
                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource Err.Text}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cartes -->
            <ItemsControl x:Name="CardsControl" ItemsSource="{Binding Cards}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><StaticResource ResourceKey="PlacedAt"/></ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <!-- Étiquettes rondes des blocs : toucher = régler, poignée = déplacer le bloc -->
            <ItemsControl x:Name="BlockLabels" ItemsSource="{Binding Blocks}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ed:BlockFrameModel}">
                        <Grid Width="{Binding Width}" Height="26" Margin="0,-13,0,0">
                            <Border x:Name="Pill" HorizontalAlignment="Center" Height="26" CornerRadius="13" Background="White" BorderBrush="{StaticResource Accent.Border}" BorderThickness="1" Padding="6,0,4,0"
                                    dd:Drag.Source="{Binding Block}" dd:Drag.Handle="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:Icon Glyph="{Binding Icon}" FontSize="16" Foreground="{StaticResource Accent.Text}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent.Text}"/>
                                    <TextBlock Text="{Binding LabelSub}" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="6,0,6,0"/>
                                    <TextBlock x:Name="Res" Text="{Binding Result}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ok.Text}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Result, Converter={x:Static infra:Conv.NotEmptyToVis}}" Value="Visible">
                                <Setter TargetName="Res" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent.Bg}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Marqueur de fin -->
            <ItemsControl ItemsSource="{Binding EndMarkers}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><StaticResource ResourceKey="PlacedAt"/></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ed:EndMarkerModel}">
                        <Border Width="{Binding Width}" Height="30" HorizontalAlignment="Center" CornerRadius="15" Background="White" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:Icon Glyph="refresh" FontSize="16" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- En-têtes de couloirs collants (calés sur le défilement vertical par le code de la vue) -->
            <ItemsControl x:Name="LaneHeaders" ItemsSource="{Binding Lanes}" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Top" Height="38">
                <ItemsControl.RenderTransform>
                    <TranslateTransform x:Name="HeaderShift" Y="0"/>
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ed:LaneModel}">
                        <Border Width="{Binding Width}" Height="36" Background="White" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,1,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:Icon Glyph="{Binding Icon}" FontSize="18" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral.Text}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ManualChannel" Id="{b3171f81-243d-5104-9a63-d2402a7c59c0}" SpecialFunc="None">
    <Declaration><![CDATA[// Canal manuel d'une station ou de la machine (canal 0) (docs/05 § 7) : action, jog avec garde, acquittement,
// apprentissage. Conditions : mode Maintenance et hôte Stopped ; les droits sont contrôlés par la HMI.
FUNCTION_BLOCK FB_ManualChannel
VAR
    _nStation : USINT;              // 0 = machine
    _ipHost : I_ManualHost;
    _nLastSeq : UDINT;
    _nObject : UINT;                // objet de l'action en cours, 0 = aucune
    _bJog : BOOL;
    _nLastAlive : UDINT;
    _fQuietMs : LREAL;
    _eStateAtStart : E_State;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Apprentissage : position actuelle des axes indiqués, composantes choisies (docs/05 § 7)
]]></ST>
    </Implementation>
    <Method Name="Init" Id="{85061e2a-2e6f-5385-820b-e64a9c2674bd}">
      <Declaration><![CDATA[METHOD Init
VAR_INPUT
    nStation : USINT;
    ipHost : I_ManualHost;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_nStation := nStation;
_ipHost := ipHost;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cycle" Id="{d0ea3da0-910d-52db-b54f-ef3690b20fb0}">
      <Declaration><![CDATA[METHOD Cycle
VAR
    req : REFERENCE TO ST_ManualRequest;
    resp : REFERENCE TO ST_ManualResponse;
    ipObj : I_Object;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ipHost = 0 OR _nStation > GVL_Const.MAX_STATIONS THEN RETURN; END_IF
req REF= GVL_Hmi.aManual[_nStation];
resp REF= GVL_Hmi.aManualResp[_nStation];

// Suivi de l'action en cours
IF _nObject <> 0 THEN
    ipObj := _ipHost.ObjectAt(_nObject);
    IF ipObj <> 0 THEN
        resp.eActStatus := ipObj.ActStatus;
        resp.nErrorCode := ipObj.Status.nErrorCode;
        resp.nSubCode := ipObj.Status.nSubCode;
        resp.stResults := ipObj.Results;
        IF _bJog THEN
            // Garde du jog : la HMI incrémente nJogAlive toutes les 100 ms bouton tenu
            IF GVL_Hmi.nJogAlive <> _nLastAlive THEN
                _nLastAlive := GVL_Hmi.nJogAlive;
                _fQuietMs := 0;
            ELSE
                _fQuietMs := _fQuietMs + F_CycleMs();
            END_IF
            IF _fQuietMs >= GVL_Const.JOG_GUARD_MS OR _ipHost.State <> _eStateAtStart THEN
                ipObj.Abort();
                _bJog := FALSE;
                _nObject := 0;
            END_IF
        ELSIF ipObj.ActStatus <> E_ActStatus.Busy THEN
            _nObject := 0;
        END_IF
    ELSE
        _nObject := 0;
    END_IF
END_IF

IF req.nSeq = _nLastSeq THEN RETURN; END_IF
_nLastSeq := req.nSeq;
resp.nSeq := req.nSeq;
resp.eReason := E_RejectReason.None;
resp.eResult := E_CmdResult.Rejected;
IF _ipHost.Mode <> E_Mode.Maintenance THEN resp.eReason := E_RejectReason.WrongMode; RETURN; END_IF
IF _ipHost.State <> E_State.Stopped THEN resp.eReason := E_RejectReason.WrongState; RETURN; END_IF
IF req.eKind <> E_ManualKind.TeachPosition AND (req.nObject < 1 OR req.nObject > GVL_Const.MAX_OBJ_PER_STATION) THEN
    resp.eReason := E_RejectReason.NotConfigured;
    RETURN;
END_IF
IF req.eKind <> E_ManualKind.TeachPosition THEN
    ipObj := _ipHost.ObjectAt(req.nObject);
    IF ipObj = 0 THEN resp.eReason := E_RejectReason.NotConfigured; RETURN; END_IF
END_IF

CASE req.eKind OF
    E_ManualKind.Action, E_ManualKind.JogStart:
        IF _nObject <> 0 THEN resp.eReason := E_RejectReason.Busy; RETURN; END_IF
        resp.eStart := ipObj.Start(req.nAction, req.stParams, TRUE);
        IF resp.eStart = E_StartResult.Accepted THEN
            _nObject := req.nObject;
            _bJog := req.eKind = E_ManualKind.JogStart;
            _nLastAlive := GVL_Hmi.nJogAlive;
            _fQuietMs := 0;
            _eStateAtStart := _ipHost.State;
            resp.eResult := E_CmdResult.Accepted;
        END_IF
        resp.eActStatus := ipObj.ActStatus;
        resp.stResults := ipObj.Results;
    E_ManualKind.JogStop:
        ipObj.Abort();
        _bJog := FALSE;
        _nObject := 0;
        resp.eResult := E_CmdResult.Accepted;
    E_ManualKind.Ack:
        ipObj.Ack();
        resp.eResult := E_CmdResult.Accepted;
    E_ManualKind.TeachPosition:
        resp.eResult := SEL(_Teach(req := req, stTaught => resp.stTaught), E_CmdResult.Rejected, E_CmdResult.Accepted);
        IF resp.eResult = E_CmdResult.Rejected THEN resp.eReason := E_RejectReason.NotConfigured; END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Teach" Id="{e70542e3-7988-59af-ae7f-5893752f609f}">
      <Declaration><![CDATA[METHOD PRIVATE _Teach : BOOL
VAR_INPUT
    req : REFERENCE TO ST_ManualRequest;
END_VAR
VAR_OUTPUT
    stTaught : ST_Position;
END_VAR
VAR
    k : USINT;
    n : UINT;
    fValue : LREAL;
    pPos : POINTER TO ST_NamedPos;
    ipObj : I_Object;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Teach := FALSE;
pPos := _ipHost.NamedPos(req.nTeachPos);
IF pPos = 0 THEN RETURN; END_IF
stTaught := pPos^.stPos;
FOR k := 1 TO 4 DO
    n := req.aTeachFrom[k];
    IF (SHR(req.nTeachMask, k - 1) AND 1) = 1 THEN
        ipObj := _ipHost.ObjectAt(n);
        IF ipObj <> 0 THEN
            fValue := ipObj.Status.aValue[1];
            CASE k OF
                1: stTaught.fX := fValue;
                2: stTaught.fY := fValue;
                3: stTaught.fZ := fValue;
                4: stTaught.fC := fValue;
            END_CASE
        END_IF
    END_IF
END_FOR
pPos^.stPos := stTaught;
pPos^.bTaught := TRUE;
_Teach := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

<UserControl x:Class="Hmi.Views.OrdersPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="Ordres de fabrication" Style="{StaticResource TitleText}"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding EditHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                     IsEnabled="{Binding CanEdit}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Width="220"/>
                            <TextBlock Text="{Binding Quantity, StringFormat=Quantité : {0}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Nouvel OF" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                <TextBlock Text="Référence" Style="{StaticResource MutedText}"/>
                <TextBox Text="{Binding NewReference, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Quantité" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Créer l'OF" Command="{Binding CreateCommand}" Style="{StaticResource TouchButton}"
                        Margin="4,14,4,4"/>
                <TextBlock Text="{Binding Message}" Margin="4,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="StdMachine.Hmi.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Text="Système" Style="{StaticResource Type.PageTitle}" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Connexion PLC" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><c:StatusDot Tone="Sim" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding ConnectionText}" FontWeight="Medium"/></StackPanel>
                            <TextBlock Text="AMS Net Id 127.0.0.1.1.1 · port 851" Style="{StaticResource Type.Caption}"/>
                            <TextBlock Text="Empreinte du projet dans le PLC : 9F3A1C07D2E84B66" Style="{StaticResource Type.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Simulateur" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Échelle de temps" Style="{StaticResource Type.Caption}" Margin="2,0,0,4"/>
                            <c:NumberField Label="Échelle de temps" Value="{Binding TimeScale, Mode=TwoWay}" Minimum="0.1" Maximum="20" Step="0.5" Decimals="1" Unit="×" Margin="0,0,0,10"/>
                            <TextBlock Text="Taux d'échec des opérations" Style="{StaticResource Type.Caption}" Margin="2,0,0,4"/>
                            <c:NumberField Label="Taux d'échec des opérations" Value="{Binding FailRate, Mode=TwoWay}" Minimum="0" Maximum="100" Step="1" Decimals="0" Unit="%" Margin="0,0,0,10"/>
                            <TextBlock Text="Disponible avec le simulateur (phase 4). Aucun effet en mode démonstration." Style="{StaticResource Type.Caption}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCard}">
                        <StackPanel>
                            <TextBlock Text="Affichage" Style="{StaticResource SectionTitle}"/>
                            <DockPanel Height="52"><CheckBox Style="{StaticResource Toggle}" DockPanel.Dock="Right" IsChecked="{Binding Reduced, Mode=TwoWay}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Réduire les animations" FontWeight="Medium"/><TextBlock Text="Supprime pulsations, flux et secousses" Style="{StaticResource Type.Caption}"/></StackPanel></DockPanel>
                            <DockPanel Height="52"><CheckBox Style="{StaticResource Toggle}" DockPanel.Dock="Right" IsChecked="{Binding Kiosk, Mode=TwoWay}"/><TextBlock Text="Mode kiosque" FontWeight="Medium" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Text="Temps de déconnexion automatique" Style="{StaticResource Type.Caption}" Margin="2,0,0,4"/>
                            <c:NumberField Label="Temps de déconnexion automatique" Value="{Binding LogoutMinutes, Mode=TwoWay}" Minimum="1" Maximum="240" Step="1" Decimals="0" Unit="min" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,14" Padding="0,14,0,0">
                        <StackPanel>
                            <DockPanel Margin="16,0,16,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Ouvrir" Height="44" MinHeight="44" Margin="0,0,6,0" Command="{Binding InfoCommand}" CommandParameter="Ouvrir un projet"/>
                                    <Button Content="Importer" Height="44" MinHeight="44" Margin="0,0,6,0" Command="{Binding InfoCommand}" CommandParameter="Importer un projet"/>
                                    <Button Content="Exporter" Height="44" MinHeight="44" Command="{Binding InfoCommand}" CommandParameter="Exporter le projet"/>
                                </StackPanel>
                                <TextBlock Text="Projet" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="HISTORIQUE DES DÉPLOIEMENTS" Style="{StaticResource Type.Caps}" Margin="16,4,0,4"/>
                            <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRow}" Height="72">
                                            <DockPanel Margin="16,0">
                                                <Button DockPanel.Dock="Right" Content="Restaurer" Height="44" MinHeight="44" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" FontSize="14.5"><Run Text="{Binding At, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Hash, Mode=OneWay}"/></TextBlock>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource TableCellMuted}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Outils" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel>
                                <Button Content="Exporter les constantes PLC" c:Ui.Icon="download" Command="{Binding ExportConstantsCommand}" Margin="0,0,10,10"/>
                                <Button Content="Essai tactile" c:Ui.Icon="touch_app" Command="{Binding OpenTouchTestCommand}" Margin="0,0,10,10"/>
                                <Button Content="Composants" c:Ui.Icon="dashboard" Command="{Binding OpenComponentsCommand}" Margin="0,0,10,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCard}">
                        <StackPanel>
                            <TextBlock Text="À propos" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Version}" Margin="0,0,0,4"/>
                            <TextBlock Text="Polices IBM Plex Sans (licence OFL) et Material Symbols (Apache 2.0)." Style="{StaticResource Type.Caption}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

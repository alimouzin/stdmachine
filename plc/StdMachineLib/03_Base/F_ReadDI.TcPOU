<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="F_ReadDI" Id="{d30c6996-2ed6-5a04-97ca-a1c6b714a87e}" SpecialFunc="None">
    <Declaration><![CDATA[// Lecture d'une entrée numérique par référence (docs/04 § 6.1) : référence invalide -> FALSE
FUNCTION F_ReadDI : BOOL
VAR_INPUT
    stRef : ST_SignalRef;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF stRef.eKind <> E_SignalKind.DI OR GVL_IoRef.pDI = 0 OR stRef.nIndex < 0 OR stRef.nIndex >= GVL_Const.MAX_DI THEN
    F_ReadDI := FALSE;
    RETURN;
END_IF
F_ReadDI := GVL_IoRef.pDI^[stRef.nIndex] XOR stRef.bInvert;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>

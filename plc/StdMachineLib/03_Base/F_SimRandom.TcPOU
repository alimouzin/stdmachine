<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="F_SimRandom" Id="{ae715153-5097-5f8d-a821-d0cef06a074b}" SpecialFunc="None">
    <Declaration><![CDATA[// Nombre pseudo-aléatoire dans [0, 1) pour les objets simulés (générateur congruentiel, Numerical Recipes)
FUNCTION F_SimRandom : LREAL
]]></Declaration>
    <Implementation>
      <ST><![CDATA[GVL_Sim.nSeed := GVL_Sim.nSeed * 1664525 + 1013904223;
F_SimRandom := UDINT_TO_LREAL(GVL_Sim.nSeed) / 4294967296.0;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>

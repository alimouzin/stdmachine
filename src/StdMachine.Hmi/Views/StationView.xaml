<UserControl x:Class="StdMachine.Hmi.Views.StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:ed="clr-namespace:StdMachine.Hmi.Editor"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             xmlns:res="clr-namespace:StdMachine.Hmi.Resources"
             Background="{StaticResource Bg.App}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="TabPane" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <c:StationChipBar Grid.Row="0" DataContext="{Binding Chips}" Margin="0,0,0,12"/>

        <!-- En-tête -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:OverrideControl Value="{Binding OverridePercent, Mode=OneWay}" Label="Override station" Margin="0,0,16,0"/>
                    <c:Beacon Size="Medium" Lights="{Binding Lights}" Blinking="{Binding Blinking}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Type.PageTitle}" Margin="0,0,14,0"/>
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,0,16,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><c:StatusPill Tone="Accent" Text="{Binding}" Margin="0,0,6,0" VerticalAlignment="Center"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:StateBadge State="{Binding State}" Size="Large" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Style="{StaticResource Type.Caption}" VerticalAlignment="Center"><Run Text="depuis"/><Run Text=" "/><Run Text="{Binding StateSince, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <c:StatusPill Tone="Maint" Text="Hors production" IconName="engineering" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding OutOfProduction, Converter={x:Static infra:Conv.BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Station Aborted : réintégration en trois touchers -->
        <Border Grid.Row="2" Background="{StaticResource Err.Bg}" BorderBrush="{StaticResource Err.Dot}" BorderThickness="1.5" CornerRadius="{StaticResource Radius.L}" Padding="20,12" Margin="0,0,0,12"
                Visibility="{Binding IsAborted, Converter={x:Static infra:Conv.BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="1" FontWeight="Bold" Foreground="{StaticResource Err.Text}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button Content="{res:T Cmd.Clear}" Command="{Binding ClearCommand}" c:Ui.Variant="Primary" c:Ui.Icon="cleaning_services" Margin="0,0,16,0"/>
                    <TextBlock Text="2" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button Content="{res:T Cmd.Reset}" IsEnabled="False" c:Ui.Icon="restart_alt" Margin="0,0,16,0"/>
                    <TextBlock Text="3" FontWeight="Bold" Foreground="{StaticResource Text.Disabled}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button Content="{res:T Cmd.Start}" IsEnabled="False" c:Ui.Icon="play_arrow"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Icon Glyph="report" FontSize="30" Foreground="{StaticResource Err.Dot}" Margin="0,0,12,0" Opacity="{Binding Source={x:Static infra:BlinkClock.Instance}, Path=Opacity}"/>
                    <TextBlock Text="{Binding AbortTitle}" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource Err.Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Réintégration en cours (Stopped, Resetting, Idle) -->
        <Border Grid.Row="2" Background="{StaticResource Warn.Bg}" BorderBrush="{StaticResource Warn.Dot}" BorderThickness="1.5" CornerRadius="{StaticResource Radius.L}" Padding="20,12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsAborted}" Value="False"/>
                                <Condition Binding="{Binding ReintegrationStep, Converter={x:Static infra:Conv.PositiveToVis}}" Value="Visible"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Icon Glyph="check_circle" Foreground="{StaticResource Ok.Dot}" Margin="0,0,6,0"/>
                    <Button Content="{res:T Cmd.Clear}" IsEnabled="False" Margin="0,0,10,0"/>
                    <Button Content="{res:T Cmd.Reset}" Command="{Binding ResetCommand}" c:Ui.Variant="Primary" c:Ui.Icon="restart_alt" Margin="0,0,10,0"/>
                    <Button Content="{res:T Cmd.Start}" Command="{Binding StartCommand}" c:Ui.Icon="play_arrow"/>
                </StackPanel>
                <TextBlock Text="{Binding ReintegratedText}" FontWeight="SemiBold" Foreground="{StaticResource Warn.Text}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="3" Style="{StaticResource Tabs}" SelectedIndex="{Binding TabIndex, Mode=TwoWay}" Margin="0,0,0,0">
            <ListBoxItem Content="Exécution"/>
            <ListBoxItem Content="Objets"/>
            <ListBoxItem Content="Variables"/>
            <ListBoxItem Content="Historique"/>
        </ListBox>

        <!-- ================= Exécution ================= -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="{StaticResource Size.SidePanel.Length}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1" Background="{StaticResource Bg.Surface}">
                        <DockPanel Margin="16,0">
                            <Button DockPanel.Dock="Right" Content="Voir dans l'éditeur" c:Ui.Icon="account_tree" c:Ui.Variant="Ghost" Command="{Binding OpenInEditorCommand}"/>
                            <c:StatusPill DockPanel.Dock="Right" Tone="Step" Text="Suivi suspendu — Reprendre" IconName="pause" Margin="0,0,8,0" Visibility="{Binding FollowSuspended, Converter={x:Static infra:Conv.BoolToVis}}">
                                <c:StatusPill.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ResumeFollowCommand}"/>
                                </c:StatusPill.InputBindings>
                            </c:StatusPill>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:Icon Glyph="account_tree" Foreground="{StaticResource Text.Secondary}" Margin="0,0,8,0"/>
                                <TextBlock Text="Process :" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Toggle}" Content="Suivre l'exécution" IsChecked="{Binding Following, Mode=TwoWay}" Margin="24,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ed:ProcessCanvasView x:Name="CanvasView" Grid.Row="1" DataContext="{Binding Canvas}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="OPÉRATION EN COURS" Style="{StaticResource Type.Caps}"/>
                            <TextBlock Text="{Binding OperationTitle}" Style="{StaticResource Type.Title}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MoverText}" Style="{StaticResource Type.Caption}" Margin="0,4,0,0"/>
                            <DockPanel Margin="0,10,0,0" Visibility="{Binding HasOperation, Converter={x:Static infra:Conv.BoolToVis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OperationTime}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <c:ProgressStrip BarHeight="8" Value="{Binding OperationProgress}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{StaticResource Border.Divider}" Margin="0,14,0,12"/>
                            <TextBlock Text="En cours :" Style="{StaticResource Type.Caption}"/>
                            <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentDetail}" Style="{StaticResource Type.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Suivante :" Style="{StaticResource Type.Caption}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding NextTitle}" FontWeight="Medium" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="CONTEXTES ACTIFS" Style="{StaticResource Type.Caps}" Margin="0,14,0,6" Visibility="{Binding Contexts.Count, Converter={x:Static infra:Conv.PositiveToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Contexts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <c:StatusDot Tone="Busy" Pulse="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Type.Caption}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StepTitle}" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PAS À PAS (MAINTENANCE)" Style="{StaticResource Type.Caps}"/>
                            <CheckBox Style="{StaticResource Toggle}" Content="Pas à pas" IsChecked="{Binding StepModeOn, Mode=TwoWay}" IsEnabled="{Binding MaintenanceMode}" Margin="0,8,0,8"/>
                            <ListBox Style="{StaticResource Segmented}" SelectedIndex="{Binding GranularityIndex, Mode=TwoWay}" IsEnabled="{Binding MaintenanceMode}" HorizontalAlignment="Left">
                                <ListBoxItem Content="Opération"/>
                                <ListBoxItem Content="Étape"/>
                                <ListBoxItem Content="Action"/>
                            </ListBox>
                            <Button Content="PAS SUIVANT" Command="{Binding NextStepCommand}" IsEnabled="{Binding MaintenanceMode}" c:Ui.Variant="Primary" c:Ui.Icon="skip_next" Height="64" Margin="0,12,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="Disponible en mode Maintenance. Abort pour abandonner." Style="{StaticResource Type.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="QUALITÉ" Style="{StaticResource Type.Caps}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <c:StatusPill Tone="Neutral" Text="{Binding ConsecutiveText}" Margin="0,0,8,0"/>
                                <c:StatusPill Tone="Neutral" Text="{Binding RateText}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding QualityText}" Foreground="{StaticResource Err.Text}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding QualityHold, Converter={x:Static infra:Conv.BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Objets ================= -->
        <ScrollViewer Grid.Row="4" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding Objects}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="286" Height="150" Margin="0,0,14,14" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.L}" Padding="14,12" Effect="{StaticResource Shadow.Card}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <c:StatusPill DockPanel.Dock="Right" Tone="{Binding Tone}" Text="{Binding StateText}" VerticalAlignment="Top"/>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Bg.Sunken}" Margin="0,0,10,0">
                                        <c:Icon Glyph="{Binding Icon}" FontSize="24" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                        <TextBlock Text="{Binding TypeName}" Style="{StaticResource Type.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Height="6" Maximum="1" Value="{Binding Gauge}" Visibility="{Binding ShowGauge, Converter={x:Static infra:Conv.BoolToVis}}" Margin="0,6,0,0" Foreground="{StaticResource Busy.Dot}" Background="{StaticResource Border.Divider}" BorderThickness="0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding Action}" FontSize="12" Foreground="{StaticResource Accent.Text}" TextTrimming="CharacterEllipsis"/>
                                    <c:ProgressStrip BarHeight="4" Value="{Binding Progress}" Margin="0,4,0,0" Visibility="{Binding IsBusy, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                    <TextBlock Text="{Binding Error}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Err.Text}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Sim.Bg}" Padding="6,1" CornerRadius="0,0,0,6" Margin="-14,-12,-14,0"
                                        Visibility="{Binding IsSimulated, Converter={x:Static infra:Conv.BoolToVis}}">
                                    <TextBlock Text="SIM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Sim.Text}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Err.Dot}"/>
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Err.Bg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Busy.Dot}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ================= Variables ================= -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="VARIABLES DE STATION" Style="{StaticResource Type.Caps}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Variables}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{StaticResource Size.Row}">
                                    <Rectangle Height="1" Fill="{StaticResource Border.Divider}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Type}" Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Medium"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="DONNÉES DE LA PIÈCE EN COURS" Style="{StaticResource Type.Caps}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding PartData}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{StaticResource Size.Row}">
                                    <Rectangle Height="1" Fill="{StaticResource Border.Divider}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Type.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="—" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Text.Tertiary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Historique ================= -->
        <Border Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource Card}" VerticalAlignment="Top" MaxHeight="800">
            <Border.Resources>
                <Style TargetType="Border" x:Key="HistoryHost"/>
            </Border.Resources>
            <Border.Visibility>
                <Binding Path="TabIndex" Converter="{x:Static infra:Conv.EqualsParamToVis}" ConverterParameter="3"/>
            </Border.Visibility>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="50 DERNIÈRES OPÉRATIONS" Style="{StaticResource Type.Caps}" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{StaticResource Size.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="5" Height="1" Fill="{StaticResource Border.Divider}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding Time}" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Part}" VerticalAlignment="Center" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Operation}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                                    <c:StatusPill Grid.Column="4" Text="{Binding Verdict}" Tone="Ok" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

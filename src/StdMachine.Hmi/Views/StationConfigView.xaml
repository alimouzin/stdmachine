<UserControl x:Class="StdMachine.Hmi.Views.StationConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:dd="clr-namespace:StdMachine.Hmi.DragDrop"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,10,24,8">
            <c:StationChipBar DataContext="{Binding Chips}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button c:Ui.Icon="undo" c:Ui.Variant="Ghost" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Width="48" Padding="0"/>
                <Button c:Ui.Icon="redo" c:Ui.Variant="Ghost" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Width="48" Padding="0" Margin="0,0,10,0"/>
                <c:StatusPill Tone="Err" Text="{Binding Summary}" IconName="fact_check" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Déployer" c:Ui.Variant="Primary" c:Ui.Icon="cloud_upload" Command="{Binding DeployCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Arborescence -->
            <Border Style="{StaticResource PageCard}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROJET" Style="{StaticResource Type.Caps}" Margin="6,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StationName}" FontWeight="SemiBold" FontSize="16" Margin="6,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Tree}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Height="48" Margin="{Binding Indent}" CornerRadius="8" Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <DockPanel Margin="8,0">
                                            <c:StatusDot DockPanel.Dock="Right" Tone="{Binding Tone}" VerticalAlignment="Center" Visibility="{Binding Node, Converter={x:Static infra:Conv.NotNullToVis}}"/>
                                            <c:Icon DockPanel.Dock="Left" Glyph="{Binding Icon}" FontSize="21" Foreground="{StaticResource Text.Secondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Accent.Bg}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Centre -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="400"/>
                </Grid.RowDefinitions>

                <!-- Vue de dessus -->
                <Border Grid.Row="0" Style="{StaticResource PageCard}" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,6">
                            <Button DockPanel.Dock="Right" Content="Ouvrir le process" c:Ui.Icon="account_tree" Command="{Binding GoProcessCommand}" Height="44" MinHeight="44"/>
                            <TextBlock VerticalAlignment="Center"><Run Text="{Binding StationName, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"/><Run Text=" — vue de dessus · "/><Run Text="{Binding WorkArea, Mode=OneWay}"/></TextBlock>
                        </DockPanel>
                        <Border Background="{StaticResource Bg.SurfaceAlt}" dd:Drop.Target="{Binding DropHandler}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Width="1200" Height="520">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="{Binding Width}" Height="{Binding Height}" CornerRadius="12" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" Padding="12,10" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:Icon Glyph="{Binding Icon}" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5"/>
                                                            <TextBlock Text="{Binding TypeName}" Style="{StaticResource TableCellMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Children}" Focusable="False" Margin="0,8,0,0" Visibility="{Binding IsModule, Converter={x:Static infra:Conv.BoolToVis}}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource Bg.SurfaceAlt}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,6,6">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <c:Icon Glyph="{Binding Icon}" FontSize="16" Foreground="{StaticResource Text.Secondary}" Margin="0,0,5,0"/>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsSimulated}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Sim.Dot}"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Onglets du bas -->
                <Border Grid.Row="2" Style="{StaticResource PageCard}" Padding="0">
                    <DockPanel>
                        <ListBox DockPanel.Dock="Top" Style="{StaticResource Tabs}" SelectedIndex="{Binding BottomTab, Mode=TwoWay}" Margin="12,0">
                            <ListBoxItem Content="Positions"/>
                            <ListBoxItem Content="Variables"/>
                            <ListBoxItem Content="Vitesses"/>
                            <ListBoxItem Content="Verrouillages"/>
                            <ListBoxItem Content="Recettes de presse"/>
                            <ListBoxItem Content="Capacités"/>
                            <ListBoxItem Content="Fonctions"/>
                        </ListBox>
                        <Grid>
                            <!-- Positions -->
                            <DockPanel Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=0}">
                                <Button DockPanel.Dock="Bottom" Content="+ Ajouter une position" HorizontalAlignment="Left" Margin="16,8,0,10" Command="{Binding AddPositionCommand}"/>
                                <Grid DockPanel.Dock="Top" Margin="16,10,16,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="NOM" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="1" Text="X" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="2" Text="Y" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="3" Text="Z" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="4" Text="C" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="5" Text="APPROCHE" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="6" Text="ÉTAT" Style="{StaticResource TableHead}"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsControl ItemsSource="{Binding Positions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="52">
                                                    <Grid Margin="16,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding X}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="2" Text="{Binding Y}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="3" Text="{Binding Z}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="4" Text="{Binding C}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="5" Text="{Binding Approach}" Style="{StaticResource TableCell}"/>
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <c:Icon x:Name="Mark" Glyph="check_circle" FontSize="20" Foreground="{StaticResource Ok.Dot}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding State}" Style="{StaticResource TableCell}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Taught}" Value="False"><Setter TargetName="Mark" Property="Glyph" Value="cancel"/><Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Err.Dot}"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <!-- Variables -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=1}">
                                <ItemsControl ItemsSource="{Binding Variables}" Focusable="False" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}" Height="52">
                                                <Grid Margin="16,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource TableCellMuted}"/><TextBlock Grid.Column="2" Text="{Binding Initial}" Style="{StaticResource TableCell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Vitesses -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=2}">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="16,0,16,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="AXE" Style="{StaticResource TableHead}"/>
                                        <TextBlock Grid.Column="1" Text="V1 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="2" Text="V2 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="3" Text="V3 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="4" Text="V4 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="5" Text="V5 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="6" Text="V6 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="7" Text="V7 %" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="8" Text="V8 %" Style="{StaticResource TableHead}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Speeds}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="52">
                                                    <Grid Margin="16,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Axis}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Values[0]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="2" Text="{Binding Values[1]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="3" Text="{Binding Values[2]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="4" Text="{Binding Values[3]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="5" Text="{Binding Values[4]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="6" Text="{Binding Values[5]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="7" Text="{Binding Values[6]}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="8" Text="{Binding Values[7]}" Style="{StaticResource TableCell}"/>
                                                        <TextBlock Grid.Column="9" Text="{Binding Detail}" Style="{StaticResource TableCellMuted}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Verrouillages -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=3}">
                                <ItemsControl ItemsSource="{Binding Locks}" Focusable="False" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}" Height="56">
                                                <Grid Margin="16,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="300"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Object}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Actions}" Style="{StaticResource TableCell}"/><TextBlock Grid.Column="2" Text="{Binding Condition}" Style="{StaticResource TableCell}"/>
                                                    <c:StatusPill Grid.Column="3" Tone="Neutral" Text="Généré" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding Generated, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Recettes de presse -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=4}">
                                <ItemsControl ItemsSource="{Binding Recipes}" Focusable="False" Margin="16,12,16,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"><Run Text="Recette n° "/><Run Text="{Binding Number, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                                <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource TableCellMuted}" Margin="0,0,0,2"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  course "/><Run Text="{Binding Start, Mode=OneWay}"/><Run Text=" à "/><Run Text="{Binding End, Mode=OneWay}"/><Run Text=" mm  ·  force "/><Run Text="{Binding ForceMin, Mode=OneWay}"/><Run Text=" à "/><Run Text="{Binding ForceMax, Mode=OneWay}"/><Run Text=" kN"/></TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Capacités -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=5}">
                                <ItemsControl ItemsSource="{Binding Capabilities}" Focusable="False" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}" MinHeight="52">
                                                <Grid Margin="16,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Object}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Items}" Style="{StaticResource TableCellMuted}" TextWrapping="Wrap" TextTrimming="None"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Fonctions personnalisées -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding BottomTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=6}">
                                <StackPanel Margin="16,12,16,12">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Nouvelle fonction" c:Ui.Variant="Primary" c:Ui.Icon="add" Command="{Binding NewFunctionCommand}" Height="44" MinHeight="44"/>
                                        <TextBlock Text="Fonctions personnalisées" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="Une fonction personnalisée assemble des actions de base du module ; elle apparaît dans la palette de l'éditeur de process avec un crayon ✎." Style="{StaticResource Type.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding CustomFns}" Focusable="False" Margin="0,0,0,16">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="68">
                                                    <DockPanel Margin="4,0">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Ouvrir" c:Ui.Icon="edit" Height="44" MinHeight="44" Margin="0,0,8,0" Command="{Binding DataContext.OpenFunctionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button c:Ui.Icon="delete" c:Ui.Variant="Ghost" Width="48" MinWidth="48" Height="44" MinHeight="44" Padding="0" Command="{Binding DataContext.DeleteFunctionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                        <c:Icon DockPanel.Dock="Left" Glyph="edit" FontSize="24" Foreground="{StaticResource Accent}" Margin="8,0,12,0" VerticalAlignment="Center"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock FontWeight="SemiBold" FontSize="15"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="   " /><Run Text="{Binding ModuleName, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}" FontSize="13"/></TextBlock>
                                                            <TextBlock Style="{StaticResource TableCellMuted}"><Run Text="{Binding BasedOn, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding StepsText, Mode=OneWay}"/><Run Text="  ·  paramètres : "/><Run Text="{Binding ParamsText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Duration, Mode=OneWay}"/></TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Fonctions des modules (catalogue)" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding ModuleFns}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="60">
                                                    <DockPanel Margin="4,0">
                                                        <Button DockPanel.Dock="Right" Content="Copier en fonction personnalisée" c:Ui.Icon="content_copy" Height="44" MinHeight="44" Command="{Binding DataContext.CopyFunctionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        <c:Icon DockPanel.Dock="Left" Glyph="precision_manufacturing" FontSize="22" Foreground="{StaticResource Text.Secondary}" Margin="8,0,12,0" VerticalAlignment="Center"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock FontWeight="SemiBold" FontSize="15"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="   " /><Run Text="{Binding ModuleName, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource Text.Secondary}" FontSize="13"/></TextBlock>
                                                            <TextBlock Style="{StaticResource TableCellMuted}"><Run Text="paramètres : "/><Run Text="{Binding ParamsText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Duration, Mode=OneWay}"/></TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Panneau de droite : propriétés et bibliothèque -->
            <Border Grid.Column="4" Style="{StaticResource PageCard}" Padding="0">
                <DockPanel>
                    <ListBox DockPanel.Dock="Top" Style="{StaticResource Tabs}" SelectedIndex="{Binding RightTab, Mode=TwoWay}" Margin="12,0">
                        <ListBoxItem Content="Propriétés"/>
                        <ListBoxItem Content="Bibliothèque"/>
                    </ListBox>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding RightTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=0}">
                            <StackPanel Margin="18,14,18,18" Visibility="{Binding HasSelection, Converter={x:Static infra:Conv.BoolToVis}}">
                                <TextBlock Text="{Binding SelectedName}" Style="{StaticResource Type.Title}"/>
                                <TextBlock Text="{Binding SelectedType}" Style="{StaticResource Type.Caption}" Margin="0,2,0,14"/>
                                <TextBlock Text="IDENTITÉ" Style="{StaticResource Type.Caps}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Params}" Focusable="False" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Height="40">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellMuted}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding HasFunctions, Converter={x:Static infra:Conv.BoolToVis}}" Margin="0,0,0,14">
                                    <TextBlock Text="FONCTIONS PERSONNALISÉES" Style="{StaticResource Type.Caps}" Margin="0,0,0,6"/>
                                    <Button Content="Créer une fonction personnalisée" c:Ui.Icon="add" Command="{Binding NewFunctionCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                    <Button Content="Voir les fonctions du module" c:Ui.Icon="edit" Command="{Binding ShowFunctionsCommand}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <TextBlock Text="OVERRIDE" Style="{StaticResource Type.Caps}" Margin="0,0,0,6"/>
                                <c:OverrideControl Value="{Binding OverridePercent, Mode=TwoWay}" Label="Override de l'objet" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                <TextBlock Text="SIMULATION ET DÉSACTIVATION" Style="{StaticResource Type.Caps}" Margin="0,0,0,6"/>
                                <DockPanel Height="48"><CheckBox Style="{StaticResource Toggle}" DockPanel.Dock="Right" IsChecked="{Binding Simulated, Mode=TwoWay}"/><TextBlock Text="Objet simulé" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Height="48"><CheckBox Style="{StaticResource Toggle}" DockPanel.Dock="Right" IsChecked="{Binding Disabled, Mode=TwoWay}"/><TextBlock Text="Objet désactivé" VerticalAlignment="Center"/></DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel Visibility="{Binding RightTab, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=1}" Margin="14,12,10,0">
                            <c:TextField DockPanel.Dock="Top" Text="{Binding LibraryQuery, Mode=TwoWay}" Placeholder="Rechercher un type" Label="Rechercher" Margin="0,0,4,8"/>
                            <TextBlock DockPanel.Dock="Top" Text="Glissez un type sur la vue de dessus pour l'ajouter à la station." Style="{StaticResource Type.Caption}" TextWrapping="Wrap" Margin="2,0,4,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding Library}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Caps}" Margin="4,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="52" Margin="0,0,4,3" CornerRadius="8" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" dd:Drag.Source="{Binding Drag}">
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Left" Width="40" Background="Transparent" dd:Drag.Handle="True"><c:Icon Glyph="drag_indicator" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                                    <c:Icon DockPanel.Dock="Right" Glyph="{Binding Icon}" FontSize="22" Foreground="{StaticResource Text.Tertiary}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barre de validation -->
        <Border Grid.Row="2" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0">
            <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" VerticalAlignment="Center" Margin="24,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <c:Icon x:Name="Ico" Glyph="warning" FontSize="18" Foreground="{StaticResource Warn.Dot}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Message}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="Ico" Property="Glyph" Value="error"/><Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Err.Dot}"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>

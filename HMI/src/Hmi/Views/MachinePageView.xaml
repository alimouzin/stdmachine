<UserControl x:Class="Hmi.Views.MachinePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Machine" Style="{StaticResource TitleText}"/>

            <!-- Balise machine -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Beacon}" Width="72" Height="72" Margin="0,0,20,0"
                                 Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ModeText, StringFormat=Mode {0}}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#FFF3CD" BorderBrush="#E0A100" BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,14,0,0"
                            Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DegradedText}" FontWeight="SemiBold" Foreground="#7A5900"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Commandes -->
            <ItemsControl ItemsSource="{Binding CommandButtons}" Margin="2,10,2,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Btn" Content="{Binding Label}" Command="{Binding Command}"
                                Style="{StaticResource TouchButton}" MinHeight="80" FontSize="22"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                <Setter TargetName="Btn" Property="Style" Value="{StaticResource DangerButton}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{Binding ToggleModeText}" Command="{Binding ToggleModeCommand}"
                    Style="{StaticResource NeutralButton}" HorizontalAlignment="Left" Margin="6,10,0,0"/>

            <!-- Balises de station -->
            <TextBlock Text="Stations" Style="{StaticResource SectionText}"/>
            <ItemsControl ItemsSource="{Binding Stations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="300">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Beacon}"
                                             Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StateText}"/>
                                        <TextBlock Text="{Binding GroupText}" Style="{StaticResource MutedText}" FontSize="15"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource TouchButton}"
                                            MinWidth="0" FontSize="16" Padding="12,6"/>
                                    <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource TouchButton}"
                                            MinWidth="0" FontSize="16" Padding="12,6"/>
                                    <Button Content="Forcer Abort" Command="{Binding ForceAbortCommand}"
                                            Style="{StaticResource DangerButton}" MinWidth="0" FontSize="16" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Clear / Reset : acquittement et réintégration d'une station seule. « Forcer Abort » est un outil de simulation."
                       Style="{StaticResource MutedText}" FontSize="14" Margin="6,2,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

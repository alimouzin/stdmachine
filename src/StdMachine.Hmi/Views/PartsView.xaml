<UserControl x:Class="StdMachine.Hmi.Views.PartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : movers -->
        <Border Grid.Column="0" Background="{StaticResource Bg.SurfaceAlt}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,16,20,16">
                <TextBlock DockPanel.Dock="Top" Text="Pièces et movers" Style="{StaticResource Type.PageTitle}" Margin="0,0,0,12"/>
                <c:TextField DockPanel.Dock="Top" Text="{Binding Search, Mode=TwoWay}" Placeholder="Identifiant de pièce" Label="Rechercher une pièce" Margin="0,0,0,6"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Chercher" c:Ui.Icon="search" Command="{Binding RunSearchCommand}" Height="40" MinHeight="40"/>
                    <TextBlock Text="{Binding SearchHint}" Style="{StaticResource Type.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>

                <!-- Movers à vider -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding HasToEmpty, Converter={x:Static infra:Conv.BoolToVis}}" Background="{StaticResource Accent.Bg}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="{StaticResource Radius.L}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="MOVERS À VIDER" Style="{StaticResource Type.Caps}" Foreground="{StaticResource Accent.Text}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ToEmptyMovers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6" Height="56">
                                        <c:HoldButton DockPanel.Dock="Right" Content="Confirmer le retrait" c:Ui.Variant="Primary" Width="220" Height="52" Command="{Binding DataContext.ConfirmRemovedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="16"><Run Text="Mover "/><Run Text="{Binding Number, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding PartsText}" Style="{StaticResource Type.Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Movers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Height="68" Margin="0,0,0,6" CornerRadius="10" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectMoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Where}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding PartsText}" Style="{StaticResource TableCellMuted}"/>
                                        </StackPanel>
                                        <c:StatusPill Grid.Column="2" Text="{Binding StateText}" Tone="{Binding Tone}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Accent.BgSoft}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Centre : fiche mover et historique -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="24,16,24,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource Type.PageTitle}" Margin="0,0,14,0"/>
                    <c:StatusPill Text="{Binding SelectedState}" Tone="{Binding SelectedTone}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource PageCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Process général" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding General}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Width="190" Height="64" Margin="0,0,10,10" CornerRadius="10" Background="{StaticResource Bg.SurfaceAlt}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" Padding="12,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" Style="{StaticResource Type.Caption}"/>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Accent.Bg}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="PIÈCES PORTÉES" Style="{StaticResource Type.Caps}" Margin="0,8,0,8"/>
                        <ItemsControl ItemsSource="{Binding Carried}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <c:StatusDot Tone="{Binding Tone}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Slot}" Style="{StaticResource Type.Caption}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCard}" Padding="0,14,0,0" Visibility="{Binding HasHistory, Converter={x:Static infra:Conv.BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding HistoryTitle}" Style="{StaticResource SectionTitle}" Margin="16,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Height="72">
                                        <Grid Margin="16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <c:StatusDot Tone="{Binding VerdictTone}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" FontSize="15"><Run Text="{Binding Station, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Operation, Mode=OneWay}"/></TextBlock>
                                                <TextBlock Style="{StaticResource TableCellMuted}"><Run Text="{Binding Start, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Duration, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding KeyData, Mode=OneWay}"/></TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:StatusPill Text="{Binding Verdict}" Tone="{Binding VerdictTone}" Margin="0,0,10,0"/>
                                                <Button Content="Courbe" c:Ui.Icon="show_chart" Height="44" MinHeight="44" Visibility="{Binding HasCurve, Converter={x:Static infra:Conv.BoolToVis}}"
                                                        Command="{Binding DataContext.ShowCurveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

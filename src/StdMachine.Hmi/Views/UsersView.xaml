<UserControl x:Class="StdMachine.Hmi.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Nouvel utilisateur" c:Ui.Variant="Primary" c:Ui.Icon="add" Command="{Binding NewUserCommand}"/>
            <TextBlock Text="Utilisateurs et droits" Style="{StaticResource Type.PageTitle}" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox Grid.Row="1" Style="{StaticResource Tabs}" SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
            <ListBoxItem Content="Utilisateurs"/><ListBoxItem Content="Niveaux"/><ListBoxItem Content="Droits"/><ListBoxItem Content="Journal"/>
        </ListBox>
        <Border Grid.Row="2" Style="{StaticResource PageCard}" Padding="0" Margin="0,12,0,0">
            <Grid>
                <!-- Utilisateurs -->
                <DockPanel Visibility="{Binding TabIndex, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=0}">
                    <Grid DockPanel.Dock="Top" Margin="20,14,20,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="NOM" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="1" Text="IDENTIFIANT" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="2" Text="NIVEAU" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="3" Text="DERNIÈRE CONNEXION" Style="{StaticResource TableHead}"/><TextBlock Grid.Column="4" Text="ACTIF" Style="{StaticResource TableHead}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Users}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Height="64">
                                        <Grid Margin="20,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/><ColumnDefinition Width="260"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Id}" Style="{StaticResource TableCellMuted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Level}" Style="{StaticResource TableCell}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LastLogin}" Style="{StaticResource TableCellMuted}"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:StatusDot Tone="Ok" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Button Content="Réinitialiser le mot de passe" Height="44" MinHeight="44" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <!-- Niveaux -->
                <ItemsControl ItemsSource="{Binding Levels}" Focusable="False" VerticalAlignment="Top" Margin="0,14,0,0" Visibility="{Binding TabIndex, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=1}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TableRow}" Height="64">
                                <Grid Margin="20,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource TableCell}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource TableCellMuted}"><Run Text="{Binding Users, Mode=OneWay}"/><Run Text=" utilisateur(s)"/></TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Droits -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Visibility="{Binding TabIndex, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=2}">
                    <ItemsControl ItemsSource="{Binding Rights}" Focusable="False" Margin="0,8,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Type.Caps}" Margin="20,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Rights}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}" Height="60">
                                                    <Grid Margin="20,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="15"/>
                                                            <TextBlock Text="{Binding Code}" Style="{StaticResource TableCellMuted}"/>
                                                        </StackPanel>
                                                        <c:Icon Grid.Column="1" Glyph="lock" FontSize="18" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Right" Margin="0,0,12,0" Visibility="{Binding Locked, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                                        <c:NumberField Grid.Column="2" Value="{Binding Level, Mode=TwoWay}" Minimum="0" Maximum="3" Step="1" Decimals="0" Label="Niveau minimal" IsEnabled="{Binding Locked, Converter={x:Static infra:Conv.InvBool}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Journal -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Visibility="{Binding TabIndex, Converter={x:Static infra:Conv.EqualsParamToVis}, ConverterParameter=3}">
                    <ItemsControl ItemsSource="{Binding Audit}" Focusable="False" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}" Height="64">
                                    <Grid Margin="20,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding User}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding What}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Before}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding After}" Style="{StaticResource TableCell}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

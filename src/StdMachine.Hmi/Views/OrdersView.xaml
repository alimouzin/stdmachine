<UserControl x:Class="StdMachine.Hmi.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="24,16,24,24">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Nouvel OF" c:Ui.Variant="Primary" c:Ui.Icon="add" Command="{Binding NewOrderCommand}"/>
                <TextBlock Text="Ordres de fabrication" Style="{StaticResource Type.PageTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- OF en cours -->
            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16" Padding="24,18" Visibility="{Binding HasCurrent, Converter={x:Static infra:Conv.BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Type.Title}" Margin="0,0,14,0"/>
                            <c:StatusPill Tone="Ok" Text="En cours" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentReference}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding QuantityText}" Style="{StaticResource Type.Kpi}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource Type.Value}" VerticalAlignment="Bottom" Foreground="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                        <c:ProgressStrip Good="{Binding Good}" Bad="{Binding Bad}" Active="{Binding Active}" BarHeight="14" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <c:StatusDot Tone="Ok" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding GoodText}" FontWeight="SemiBold" Margin="0,0,4,0"/><TextBlock Text="bonnes" Style="{StaticResource Type.Caption}" Margin="0,0,18,0"/>
                            <c:StatusDot Tone="Err" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding BadText}" FontWeight="SemiBold" Margin="0,0,4,0"/><TextBlock Text="mauvaises" Style="{StaticResource Type.Caption}" Margin="0,0,18,0"/>
                            <c:StatusDot Tone="Busy" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding ActiveText}" FontWeight="SemiBold" Margin="0,0,4,0"/><TextBlock Text="en cours" Style="{StaticResource Type.Caption}" Margin="0,0,24,0"/>
                            <TextBlock Text="{Binding BudgetText}" Style="{StaticResource Type.Caption}" Margin="0,0,24,0"/>
                            <TextBlock Text="{Binding EndText}" Style="{StaticResource Type.Caption}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="Suspendre" c:Ui.Icon="pause" Width="190" Command="{Binding SuspendCommand}" IsEnabled="{Binding CanSuspend}" Margin="0,0,0,8"/>
                        <Button Content="Reprendre" c:Ui.Icon="play_arrow" Width="190" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Liste -->
            <Border Style="{StaticResource PageCard}" Padding="0,14,0,0">
                <StackPanel>
                    <DockPanel Margin="16,0,16,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LaunchHint}" Style="{StaticResource Type.Caption}"/>
                        <TextBlock Text="Liste des OF" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <Grid Margin="16,0,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/><ColumnDefinition Width="200"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NUMÉRO" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="1" Text="RÉFÉRENCE" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="2" Text="ÉTAT" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="3" Text="BONNES / QTÉ" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="4" Text="REBUTS" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="5" Text="CRÉÉ" Style="{StaticResource TableHead}"/>
                        <TextBlock Grid.Column="6" Text="FIN" Style="{StaticResource TableHead}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Orders}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}" Height="64">
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/><ColumnDefinition Width="200"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Reference}" Style="{StaticResource TableCell}"/>
                                        <c:StatusPill Grid.Column="2" Text="{Binding StateText}" Tone="{Binding Tone}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding QuantityText}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding BadText}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding CreatedText}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding EndText}" Style="{StaticResource TableCellMuted}"/>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Lancer" c:Ui.Icon="play_arrow" c:Ui.Variant="Primary" Height="44" MinHeight="44" Margin="0,0,8,0"
                                                    Visibility="{Binding CanLaunch, Converter={x:Static infra:Conv.BoolToVis}}"
                                                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <c:HoldButton Content="Annuler" c:Ui.Icon="close" Width="150" Height="44" MinHeight="44"
                                                          Visibility="{Binding CanLaunch, Converter={x:Static infra:Conv.BoolToVis}}"
                                                          Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

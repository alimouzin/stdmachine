<UserControl x:Class="Hmi.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="24" Width="760">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Connexion" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Utilisateur" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                         DisplayMemberPath="Name" MaxHeight="360"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Width="300">
                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" MinHeight="64">
                    <TextBlock Text="{Binding PinDisplay}" FontSize="30" TextAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" MinHeight="28" Margin="0,6"/>
                <UniformGrid Columns="3">
                    <Button Content="1" Command="{Binding DigitCommand}" CommandParameter="1" Style="{StaticResource NeutralButton}"/>
                    <Button Content="2" Command="{Binding DigitCommand}" CommandParameter="2" Style="{StaticResource NeutralButton}"/>
                    <Button Content="3" Command="{Binding DigitCommand}" CommandParameter="3" Style="{StaticResource NeutralButton}"/>
                    <Button Content="4" Command="{Binding DigitCommand}" CommandParameter="4" Style="{StaticResource NeutralButton}"/>
                    <Button Content="5" Command="{Binding DigitCommand}" CommandParameter="5" Style="{StaticResource NeutralButton}"/>
                    <Button Content="6" Command="{Binding DigitCommand}" CommandParameter="6" Style="{StaticResource NeutralButton}"/>
                    <Button Content="7" Command="{Binding DigitCommand}" CommandParameter="7" Style="{StaticResource NeutralButton}"/>
                    <Button Content="8" Command="{Binding DigitCommand}" CommandParameter="8" Style="{StaticResource NeutralButton}"/>
                    <Button Content="9" Command="{Binding DigitCommand}" CommandParameter="9" Style="{StaticResource NeutralButton}"/>
                    <Button Content="⌫" Command="{Binding BackspaceCommand}" Style="{StaticResource NeutralButton}"/>
                    <Button Content="0" Command="{Binding DigitCommand}" CommandParameter="0" Style="{StaticResource NeutralButton}"/>
                    <Button Content="OK" Command="{Binding ConfirmCommand}" Style="{StaticResource TouchButton}"/>
                </UniformGrid>
                <Button Content="Annuler" Command="{Binding CancelCommand}" Style="{StaticResource NeutralButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_VarInit" Id="{1f88bae4-960f-5c2e-bf8c-7791f9e84595}">
    <Declaration><![CDATA[// Déclaration d'une variable de station (docs/06 § 2)
{attribute 'pack_mode' := '1'}
TYPE ST_VarInit :
STRUCT
    eType : E_VarType;
    fValue : LREAL;
    stPos : ST_Position;
    bRetain : BOOL;             // persistante (calibration), conservée au redéploiement par identifiant
    nId : UDINT;                // identifiant stable (empreinte de l'Id du projet) ; 0 = variable cachée (D92)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

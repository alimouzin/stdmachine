<UserControl x:Class="StdMachine.Hmi.Controls.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:res="clr-namespace:StdMachine.Hmi.Resources">
    <Border Background="{StaticResource Bg.Surface}" CornerRadius="{StaticResource Radius.XL}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
            Effect="{StaticResource Shadow.Overlay}" Padding="28" Width="760">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" c:Ui.Variant="Ghost" c:Ui.Icon="close" Width="48" Height="48" MinWidth="48" Click="Close_Click"/>
                <TextBlock Text="Connexion" Style="{StaticResource Type.Title}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="UTILISATEURS RÉCENTS" Style="{StaticResource Type.Caps}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="UserList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="User_Click" Height="64" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Padding="12,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Accent.Bg}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name, Converter={x:Static c:LoginPanel.Initials}}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LevelName}" Style="{StaticResource Type.Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="WhoText" Text="Choisissez un utilisateur" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource Bg.Sunken}" CornerRadius="{StaticResource Radius.M}" Height="56" Margin="0,0,0,8">
                        <TextBlock x:Name="PinText" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="○ ○ ○ ○"/>
                    </Border>
                    <TextBlock x:Name="PinError" Foreground="{StaticResource Err.Text}" FontSize="13" MinHeight="20"/>
                    <UniformGrid Columns="3" Rows="4">
                        <Button Style="{StaticResource KeyButton}" Content="1" Tag="1" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="2" Tag="2" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="3" Tag="3" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="4" Tag="4" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="5" Tag="5" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="6" Tag="6" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="7" Tag="7" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="8" Tag="8" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="9" Tag="9" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButtonAlt}" c:Ui.Icon="backspace" Click="Back_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButton}" Content="0" Tag="0" Click="Digit_Click" Width="88" Height="64"/>
                        <Button Style="{StaticResource KeyButtonAlt}" c:Ui.Icon="check" Click="Ok_Click" Width="88" Height="64"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            <Button Content="Rester en Opérateur" c:Ui.Variant="Ghost" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Operator_Click"/>
        </StackPanel>
    </Border>
</UserControl>

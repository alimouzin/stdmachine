<UserControl x:Class="StdMachine.Hmi.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <UserControl.Resources>
        <DataTemplate x:Key="CheckLine">
            <TextBlock/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <c:StationChipBar Grid.Row="0" DataContext="{Binding Chips}" Margin="0,0,0,12"/>

        <!-- Conditions d'accès -->
        <Border Grid.Row="1" Style="{StaticResource PageCard}" Margin="0,0,0,12" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Passer en Maintenance" Command="{Binding SwitchToMaintenanceCommand}" Margin="0,0,10,0" Visibility="{Binding ModeOk, Converter={x:Static infra:Conv.InvBoolToVis}}" Height="48" MinHeight="48"/>
                    <Button Content="Arrêter la station" Command="{Binding StopStationCommand}" Visibility="{Binding StateOk, Converter={x:Static infra:Conv.InvBoolToVis}}" Height="48" MinHeight="48"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Manuel disponible :" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <c:Icon Glyph="{Binding ModeOk, Converter={x:Static infra:Conv.OkIcon}}" FontSize="22" Foreground="{Binding ModeOk, Converter={x:Static infra:Conv.OkBrush}}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ModeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <c:Icon Glyph="{Binding StateOk, Converter={x:Static infra:Conv.OkIcon}}" FontSize="22" Foreground="{Binding StateOk, Converter={x:Static infra:Conv.OkBrush}}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="{Binding RightOk, Converter={x:Static infra:Conv.OkIcon}}" FontSize="22" Foreground="{Binding RightOk, Converter={x:Static infra:Conv.OkBrush}}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding RightText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- Objets -->
            <Border Grid.Column="0" Style="{StaticResource PageCard}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OBJETS" Style="{StaticResource Type.Caps}" Margin="6,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Objects}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Height="52" Margin="{Binding Indent}" CornerRadius="8" Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <DockPanel Margin="8,0">
                                            <c:StatusDot DockPanel.Dock="Right" Tone="{Binding Tone}" Pulse="{Binding IsBusy}" VerticalAlignment="Center"/>
                                            <c:Icon DockPanel.Dock="Left" Glyph="{Binding Icon}" FontSize="22" Foreground="{StaticResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Accent.Bg}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Panneau central -->
            <Border Grid.Column="2" Style="{StaticResource PageCard}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel Margin="22,18,22,22">
                        <DockPanel Margin="0,0,0,14">
                            <c:OverrideControl DockPanel.Dock="Right" Value="{Binding ManualOverride, Mode=TwoWay}" Label="Override manuel"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ObjectTitle}" Style="{StaticResource Type.PageTitle}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding ObjectType}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <c:StatusPill Text="{Binding ObjectStateText}" Tone="{Binding ObjectTone}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- valeurs -->
                        <ItemsControl ItemsSource="{Binding Values}" Focusable="False" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg.SurfaceAlt}" CornerRadius="10" Margin="0,0,10,0" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Type.Caps}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Type.Value}"/>
                                                <TextBlock Text="{Binding Unit}" Style="{StaticResource Type.Caption}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Axe : course et jog -->
                        <StackPanel Visibility="{Binding IsAxis, Converter={x:Static infra:Conv.BoolToVis}}" Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TravelText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Course (−60 à 400 mm)" Style="{StaticResource Type.Caption}"/>
                            </DockPanel>
                            <c:ProgressStrip Value="{Binding Travel}" BarHeight="14" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Width="96" Height="96" c:Ui.Icon="remove" Margin="0,0,12,0" FontSize="26"/>
                                <Button Width="96" Height="96" c:Ui.Icon="add" Margin="0,0,24,0" FontSize="26"/>
                                <TextBlock Text="Jog : maintenir un bouton pour déplacer l'axe à la vitesse lente. Le mouvement s'arrête au relâchement." Style="{StaticResource Type.Caption}" TextWrapping="Wrap" Width="300" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Plan XY du robot -->
                        <StackPanel Visibility="{Binding IsRobot, Converter={x:Static infra:Conv.BoolToVis}}" Margin="0,0,0,14">
                            <TextBlock Text="Plan XY · zone de travail 320 × 180 mm" Style="{StaticResource Type.Caption}" Margin="0,0,0,6"/>
                            <Border Width="704" Height="396" HorizontalAlignment="Left" Background="{StaticResource Bg.SurfaceAlt}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Positions}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding MapX}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding MapY}"/>
                                                <Setter Property="Visibility" Value="{Binding Mappable, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="-8,-8,0,0">
                                                    <Ellipse Width="16" Height="16" Fill="{StaticResource Accent}" Stroke="White" StrokeThickness="2"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Margin="-10,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Canvas>
                                        <Canvas Canvas.Left="{Binding CrossX}" Canvas.Top="{Binding CrossY}">
                                            <Line X1="-16" X2="16" Y1="0" Y2="0" Stroke="{StaticResource Err.Dot}" StrokeThickness="2.5"/>
                                            <Line X1="0" X2="0" Y1="-16" Y2="16" Stroke="{StaticResource Err.Dot}" StrokeThickness="2.5"/>
                                        </Canvas>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Visibility="{Binding HasActions, Converter={x:Static infra:Conv.BoolToVis}}">
                            <TextBlock Text="ACTIONS" Style="{StaticResource Type.Caps}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="64" MinWidth="210" Margin="0,0,10,10" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.ParamSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.Available, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:Icon Glyph="{Binding Icon}" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LastResult}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Positions et journal -->
            <StackPanel Grid.Column="4">
                <Border Style="{StaticResource PageCard}" Padding="0,14,0,0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Positions nommées" Style="{StaticResource SectionTitle}" Margin="16,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Positions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Height="64">
                                        <DockPanel Margin="14,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Aller" Height="44" MinHeight="44" Padding="12,0" Margin="0,0,6,0" Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Apprendre" Height="44" MinHeight="44" Padding="12,0" Command="{Binding DataContext.TeachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <c:Icon x:Name="Mark" DockPanel.Dock="Left" Glyph="check_circle" FontSize="22" Foreground="{StaticResource Ok.Dot}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5"/>
                                                <TextBlock Style="{StaticResource TableCellMuted}"><Run Text="{Binding X, Mode=OneWay}"/><Run Text=" ; "/><Run Text="{Binding Y, Mode=OneWay}"/><Run Text=" ; "/><Run Text="{Binding Z, Mode=OneWay}"/></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Taught}" Value="False">
                                            <Setter TargetName="Mark" Property="Glyph" Value="cancel"/>
                                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Err.Dot}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PageCard}" Padding="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Journal manuel" Style="{StaticResource SectionTitle}" Margin="16,0,0,8"/>
                        <TextBlock Text="Aucune action pour le moment." Style="{StaticResource Type.Caption}" Margin="16,0,16,14" Visibility="{Binding Journal.Count, Converter={x:Static infra:Conv.ZeroToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Journal}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" MinHeight="44">
                                        <DockPanel Margin="16,0">
                                            <c:Icon x:Name="Ic" DockPanel.Dock="Right" Glyph="check" Foreground="{StaticResource Ok.Dot}" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource TableCellMuted}" Width="56"/>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource TableCell}"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                            <Setter TargetName="Ic" Property="Glyph" Value="close"/>
                                            <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource Err.Dot}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Gripper" Id="{b867053a-fbc3-521f-b758-dd5cd5ba4aa4}" SpecialFunc="None">
    <Declaration><![CDATA[// Pince, type 21 (docs/03 § 5.2). Seul le pneumatique est réalisé ; l'électrique (P1 = 2) attend son interface :
// la configuration est alors refusée.
FUNCTION_BLOCK FB_Gripper EXTENDS FB_ObjectBase
VAR
    _bBistable : BOOL;
    _bCmdClose : BOOL;
    _bClosed : BOOL;
    _bOpen : BOOL;
    _bPart : BOOL;
    _bHasClosed : BOOL;
    _bHasOpen : BOOL;
    _bHasPart : BOOL;
    _bHolding : BOOL;               // fermée sur pièce : une perte de pièce est une erreur 101
    _fMove : LREAL;
    _fSimPos : LREAL;               // 0 ouverte, 1 fermée
    _bSimPart : BOOL := TRUE;       // simulation : une pièce est présente entre les doigts
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// État sûr : maintien (docs/03, catalogue)
]]></ST>
    </Implementation>
    <Method Name="_OnConfigure" Id="{8fe2d4a0-f4ef-5bd2-b7e8-193fabf509c9}">
      <Declaration><![CDATA[METHOD PROTECTED _OnConfigure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bBistable := _refCfg.aParam[1] = 1;
_bHasClosed := F_SignalValid(_refCfg.aSignal[3], E_SignalKind.DI);
_bHasOpen := F_SignalValid(_refCfg.aSignal[4], E_SignalKind.DI);
_bHasPart := F_SignalValid(_refCfg.aSignal[5], E_SignalKind.DI);
_bHolding := FALSE;
_OnConfigure := _refCfg.aParam[1] < 2
                AND F_SignalValid(_refCfg.aSignal[1], E_SignalKind.DO)
                AND (NOT _bBistable OR F_SignalValid(_refCfg.aSignal[2], E_SignalKind.DO));
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnStart" Id="{108238ee-ae17-50fe-8a62-e62006630151}">
      <Declaration><![CDATA[METHOD PROTECTED _OnStart : E_ActStatus
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fMove := 0;
CASE nAction OF
    GVL_Catalog.Gripper_Ouvrir:
        _bCmdClose := FALSE;
        _bHolding := FALSE;
        _OnStart := E_ActStatus.Busy;
    GVL_Catalog.Gripper_Fermer, GVL_Catalog.Gripper_SerrerSurPiece:
        _bCmdClose := TRUE;
        _OnStart := E_ActStatus.Busy;
    GVL_Catalog.Gripper_VerifierPresencePiece:
        _SetResult(1, BOOL_TO_LREAL(_PartPresent()));
        _OnStart := E_ActStatus.Done;
ELSE
    _OnStart := E_ActStatus.Error;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnCycle" Id="{ea2d5ca8-d36e-5f90-b2b9-b3cfff2fc838}">
      <Declaration><![CDATA[METHOD PROTECTED _OnCycle : E_ActStatus
VAR_INPUT
    nAction : UINT;
END_VAR
VAR
    bReached : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fMove := _fMove + F_CycleMs();
IF _bCmdClose THEN
    bReached := SEL(_bHasClosed, _fMove >= _refCfg.aParam[2], _bClosed);
ELSE
    bReached := SEL(_bHasOpen, _fMove >= _refCfg.aParam[2], _bOpen);
END_IF
IF NOT bReached THEN
    _OnCycle := E_ActStatus.Busy;
    RETURN;
END_IF
IF nAction = GVL_Catalog.Gripper_SerrerSurPiece THEN
    _SetResult(1, BOOL_TO_LREAL(_PartPresent()));
    IF NOT _PartPresent() THEN
        _Fail(GVL_Catalog.Gripper_Err100, 0);       // pièce absente à la fermeture
        _OnCycle := E_ActStatus.Error;
        RETURN;
    END_IF
    _bHolding := TRUE;
END_IF
_OnCycle := E_ActStatus.Done;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PartPresent" Id="{a7d134f4-14aa-5f6b-b3cd-858ce641229b}">
      <Declaration><![CDATA[METHOD PRIVATE _PartPresent : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Avec un capteur de présence : le capteur ; sinon, fermée sans atteindre la butée « fermée » = sur pièce
IF _bHasPart THEN
    _PartPresent := _bPart;
ELSE
    _PartPresent := _bCmdClose AND NOT _bOpen;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Monitor" Id="{795719e6-49a2-592b-a2d7-60be48f256b6}">
      <Declaration><![CDATA[METHOD PROTECTED _Monitor
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _bHasClosed AND _bHasOpen AND _bClosed AND _bOpen THEN
    IF _eState <> E_ObjState.Error THEN _Fail(GVL_Catalog.Gripper_Err102, 0); END_IF
ELSIF _bHolding AND _bHasPart AND NOT _bPart AND _eState <> E_ObjState.Error THEN
    _bHolding := FALSE;
    _Fail(GVL_Catalog.Gripper_Err101, 0);          // pièce perdue pendant le maintien
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SafeState" Id="{3b5c1422-adef-53bd-ad90-a7410f95f377}">
      <Declaration><![CDATA[METHOD PROTECTED _SafeState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReadHw" Id="{a8b20891-f80b-5876-9a64-55ff8e2d3cfd}">
      <Declaration><![CDATA[METHOD PROTECTED _ReadHw
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bClosed := F_ReadDI(_refCfg.aSignal[3]);
_bOpen := F_ReadDI(_refCfg.aSignal[4]);
_bPart := F_ReadDI(_refCfg.aSignal[5]);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Simulate" Id="{390c2f52-ed0f-55ce-9524-e974e788fa00}">
      <Declaration><![CDATA[METHOD PROTECTED _Simulate
VAR
    fStep : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fStep := F_CycleMs() / MAX(_refCfg.aParam[2], 10.0);
IF _bCmdClose THEN _fSimPos := MIN(1.0, _fSimPos + fStep); ELSE _fSimPos := MAX(0.0, _fSimPos - fStep); END_IF
_bOpen := _fSimPos <= 0.0;
_bClosed := _fSimPos >= 1.0;
_bPart := _bSimPart AND _bCmdClose AND _fSimPos >= 1.0;
IF _Forced(3) THEN _bClosed := _ForcedValue(3) >= 0.5; END_IF
IF _Forced(4) THEN _bOpen := _ForcedValue(4) >= 0.5; END_IF
IF _Forced(5) THEN _bPart := _ForcedValue(5) >= 0.5; END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_WriteHw" Id="{5643ecab-f590-5628-9369-ca55f1a8fdb7}">
      <Declaration><![CDATA[METHOD PROTECTED _WriteHw
]]></Declaration>
      <Implementation>
        <ST><![CDATA[F_WriteDO(_refCfg.aSignal[1], _bCmdClose);
IF _bBistable THEN F_WriteDO(_refCfg.aSignal[2], NOT _bCmdClose); END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Publish" Id="{81419552-967c-5eea-b947-da36d4ecd1f4}">
      <Declaration><![CDATA[METHOD PROTECTED _Publish
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 0 Inconnu, 1 Ouverte, 2 Fermée, 3 Fermée sur pièce
IF _bCmdClose AND _PartPresent() THEN
    _stStatus.aValue[1] := 3;
ELSIF _bCmdClose AND (_bClosed OR NOT _bHasClosed) THEN
    _stStatus.aValue[1] := 2;
ELSIF NOT _bCmdClose AND (_bOpen OR NOT _bHasOpen) THEN
    _stStatus.aValue[1] := 1;
ELSE
    _stStatus.aValue[1] := 0;
END_IF
_stStatus.aValue[2] := BOOL_TO_LREAL(_PartPresent());
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

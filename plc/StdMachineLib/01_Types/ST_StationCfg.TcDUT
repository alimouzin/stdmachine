<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_StationCfg" Id="{68a6d582-0efb-584a-9e43-ab3e18815d0e}">
    <Declaration><![CDATA[// Station dans la configuration machine (docs/06 § 4)
{attribute 'pack_mode' := '1'}
TYPE ST_StationCfg :
STRUCT
    bUsed : BOOL;
    sName : STRING(40);
    nGroupMask : UINT;          // bit n-1 = fonction n
    nWorkPos : INT;             // index dans aPlanarPos
    aQueuePos : ARRAY[1..GVL_Const.MAX_QUEUE] OF INT;   // 0 = absente
    fOverride : LREAL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

<UserControl x:Class="StdMachine.Hmi.Views.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:core="clr-namespace:StdMachine.Core;assembly=StdMachine.Core"
             xmlns:th="clr-namespace:StdMachine.Hmi.Theme"
             xmlns:res="clr-namespace:StdMachine.Hmi.Resources"
             Background="{StaticResource Bg.App}">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,16,24">
            <TextBlock Text="{res:T Gallery.Title}" Style="{StaticResource Type.PageTitle}"/>
            <TextBlock Text="{res:T Gallery.Help}" Style="{StaticResource Type.Body}" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,20"/>

            <WrapPanel Orientation="Horizontal">

                <!-- Boutons -->
                <Border Style="{StaticResource Section}" Width="620">
                    <StackPanel>
                        <TextBlock Text="{res:T Gallery.Buttons}" Style="{StaticResource Type.Caps}" Margin="0,0,0,12"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Button Content="Principal" c:Ui.Variant="Primary" c:Ui.Icon="check" Margin="0,0,10,0"/>
                            <Button Content="Secondaire" c:Ui.Icon="settings" Margin="0,0,10,0"/>
                            <Button Content="Discret" c:Ui.Variant="Ghost" c:Ui.Icon="undo" Margin="0,0,10,0"/>
                            <Button Content="Danger" c:Ui.Variant="Danger" c:Ui.Icon="delete"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Button Content="Principal" c:Ui.Variant="Primary" c:Ui.Icon="check" IsEnabled="False" Margin="0,0,10,0"/>
                            <Button Content="Secondaire" c:Ui.Icon="settings" IsEnabled="False" Margin="0,0,10,0"/>
                            <Button Content="Discret" c:Ui.Variant="Ghost" c:Ui.Icon="undo" IsEnabled="False" Margin="0,0,10,0"/>
                            <Button Content="Danger" c:Ui.Variant="Danger" c:Ui.Icon="delete" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Button Content="En cours" c:Ui.Variant="Primary" c:Ui.Icon="rocket_launch" c:Ui.IsBusy="True" Margin="0,0,10,0"/>
                            <Button c:Ui.Icon="add" Margin="0,0,10,0"/>
                            <Button c:Ui.Icon="remove" Margin="0,0,10,0"/>
                            <Button c:Ui.Icon="more_vert" c:Ui.Variant="Ghost" Margin="0,0,10,0"/>
                            <Button Content="Verrouillé" c:Ui.Icon="lock" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Commandes machine -->
                <Border Style="{StaticResource Section}" Width="1000">
                    <StackPanel>
                        <TextBlock Text="{res:T Gallery.Commands}" Style="{StaticResource Type.Caps}" Margin="0,0,0,12"/>
                        <StackPanel Style="{StaticResource Row}">
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Reset}" c:Ui.Icon="restart_alt" c:Ui.Tone="Warn" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Start}" c:Ui.Icon="play_arrow" c:Ui.Tone="Ok" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Hold}" c:Ui.Icon="pause" c:Ui.Tone="Warn" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Stop}" c:Ui.Icon="stop" c:Ui.Tone="Neutral" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Clear}" c:Ui.Icon="cleaning_services" c:Ui.Tone="Err"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Start}" c:Ui.Icon="play_arrow" c:Ui.Tone="Ok" IsEnabled="False" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource CommandButton}" Content="{res:T Cmd.Start}" c:Ui.Icon="play_arrow" c:Ui.Tone="Ok" c:Ui.IsBusy="True" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource AbortButton}" Content="Abort" c:Ui.Icon="report" Width="420"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <c:HoldButton Content="Déployer" c:Ui.Variant="Primary" c:Ui.Icon="cloud_upload" Command="{Binding HeldCommand}" Margin="0,0,10,0"/>
                            <c:HoldButton Content="Supprimer" c:Ui.Variant="Danger" c:Ui.Icon="delete" Command="{Binding HeldCommand}" Margin="0,0,10,0"/>
                            <c:HoldButton Content="Désactivé" c:Ui.Icon="lock" IsEnabled="False" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding HoldResult}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Badges d'état -->
                <Border Style="{StaticResource Section}" Width="620">
                    <StackPanel>
                        <TextBlock Text="{res:T Gallery.StateBadges}" Style="{StaticResource Type.Caps}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding States}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <c:StateBadge State="{Binding}" Size="Small" Width="130" HorizontalAlignment="Left" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <c:StateBadge State="{Binding}" Size="Medium" Width="150" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <c:StateBadge State="{Binding}" Size="Large" MinWidth="240" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Pastilles et points -->
                <Border Style="{StaticResource Section}" Width="560">
                    <StackPanel>
                        <TextBlock Text="{res:T Gallery.Pills}" Style="{StaticResource Type.Caps}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <c:StatusPill Text="Complet" Tone="Ok" IconName="check_circle" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Incomplet" Tone="Warn" IconName="warning" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Erreur" Tone="Err" IconName="error" Margin="0,0,8,8"/>
                            <c:StatusPill Text="En cours" Tone="Busy" IconName="sync" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Simulé" Tone="Sim" IconName="science" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Pas à pas" Tone="Step" IconName="skip_next" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Maintenance" Tone="Maint" IconName="key" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Arrêté" Tone="Neutral" Margin="0,0,8,8"/>
                            <c:StatusPill Text="Personnalisée" Tone="Accent" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <c:StatusDot Tone="Ok" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Warn" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Err" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Busy" Pulse="True" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Sim" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Step" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Maint" Margin="0,0,14,0"/>
                            <c:StatusDot Tone="Neutral"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Onglets, segments, interrupteurs -->
                <Border Style="{StaticResource Section}" Width="620">
                    <StackPanel>
                        <TextBlock Text="{res:T Gallery.Selectors}" Style="{StaticResource Type.Caps}" Margin="0,0,0,12"/>
                        <ListBox Style="{StaticResource Tabs}" SelectedIndex="{Binding TabIndex}" Margin="0,0,0,16">
                            <ListBoxItem Content="Exécution"/>
                            <ListBoxItem Content="Objets"/>
                            <ListBoxItem Content="Variables"/>
                            <ListBoxItem Content="Historique"/>
                            <ListBoxItem Content="Verrouillé" IsEnabled="False"/>
                        </ListBox>
                        <ListBox Style="{StaticResource Segmented}" SelectedIndex="{Binding SegmentIndex}" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ListBoxItem Content="Production"/>
                            <ListBoxItem Content="Maintenance"/>
                        </ListBox>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Toggle}" Content="Activé" IsChecked="{Binding ToggleA}" Margin="0,0,24,0"/>
                            <CheckBox Style="{StaticResource Toggle}" Content="Désactivé" IsChecked="{Binding ToggleB}" Margin="0,0,24,0"/>
                            <CheckBox Style="{StaticResource Toggle}" Content="Verrouillé" IsChecked="True" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Override -->
                <Border Style="{StaticResource Section}" Width="560">
                    <StackPanel>
                        <TextBlock Text="{res:T Gallery.Override}" Style="{StaticResource Type.Caps}" Margin="0,0,0,12"/>
                        <c:OverrideControl Value="{Binding OverrideValue, Mode=TwoWay}" Label="Override machine" Chain="80 % × 50 % × 100 % = 40 %" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <c:OverrideControl Value="{Binding OverrideZero, Mode=TwoWay}" Label="Override machine" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AlarmBuffer" Id="{1ebb2c55-8ad6-580d-984a-303b6c61e8e8}">
    <Declaration><![CDATA[// Alarmes actives et tampon d'événements (docs/06 § 6.3)
{attribute 'pack_mode' := '1'}
TYPE ST_AlarmBuffer :
STRUCT
    nActive : UINT;
    aActive : ARRAY[1..GVL_Const.ALARM_ACTIVE] OF ST_AlarmEntry;
    nWriteSeq : UDINT;              // n° du dernier événement écrit
    aEvent : ARRAY[0..GVL_Const.ALARM_EVENTS - 1] OF ST_AlarmEventRec;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AlarmEntry" Id="{118b483c-33a6-580e-90e1-2c426cf2610a}">
    <Declaration><![CDATA[// Alarme active (docs/04 § 10, docs/14)
{attribute 'pack_mode' := '1'}
TYPE ST_AlarmEntry :
STRUCT
    nGlobalId : UDINT;              // source : station × 1000 + n° local
    nCode : UINT;
    nSubCode : UDINT;
    eSeverity : E_Severity;
    eState : E_AlarmState;
    tRaised : LINT;
    tCleared : LINT;
    nRepeat : UINT;
    bCause : BOOL;                  // cause première d'un arrêt
    stCtx : ST_AlarmContext;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

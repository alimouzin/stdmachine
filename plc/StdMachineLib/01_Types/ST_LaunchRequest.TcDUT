<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_LaunchRequest" Id="{a4441038-476b-527f-a3d9-2c40f90a2ded}">
    <Declaration><![CDATA[// Maintenance : lancer une table d'une station (docs/06 § 6.2)
{attribute 'pack_mode' := '1'}
TYPE ST_LaunchRequest :
STRUCT
    nSeq : UDINT;
    nStation : USINT;               // 0 = calibration machine
    nTable : USINT;
    nMover : USINT;                 // 0 = sans mover
    nSlot : USINT;
    aParam : ARRAY[1..GVL_Const.MAX_PARAMS] OF LREAL;
    sUser : STRING(24);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

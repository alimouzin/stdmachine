<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CmdResponse" Id="{b4f8d472-cc97-5f57-9987-1bdbe4144723}">
    <Declaration><![CDATA[// Réponse commune des handshakes (docs/06 § 6.1)
{attribute 'pack_mode' := '1'}
TYPE ST_CmdResponse :
STRUCT
    nSeq : UDINT;
    eResult : E_CmdResult;
    eReason : E_RejectReason;
    eState : E_State;               // état de la cible au moment de la réponse
    nDetail : UDINT;                // précision (n° d'élément, version demandée…)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

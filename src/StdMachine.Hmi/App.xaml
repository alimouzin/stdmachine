<Application x:Class="StdMachine.Hmi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StdMachine.Hmi.ViewModels"
             xmlns:views="clr-namespace:StdMachine.Hmi.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml"/>
                <ResourceDictionary Source="Theme/Controls.Basic.xaml"/>
                <ResourceDictionary Source="Theme/Controls.Custom.xaml"/>
                <ResourceDictionary Source="Theme/Controls.Pages.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Une vue = un UserControl + une vue-modèle (docs/07 § 7) -->
            <DataTemplate DataType="{x:Type vm:MachineViewModel}">
                <views:MachineView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StationViewModel}">
                <views:StationView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProcessEditorViewModel}">
                <views:ProcessEditorView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AlarmsViewModel}">
                <views:AlarmsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QualityViewModel}">
                <views:QualityView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ForcesViewModel}">
                <views:ForcesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
                <views:OrdersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PartsViewModel}">
                <views:PartsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManualViewModel}">
                <views:ManualView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MachineConfigViewModel}">
                <views:MachineConfigView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StationConfigViewModel}">
                <views:StationConfigView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeployViewModel}">
                <views:DeployView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <views:UsersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                <views:StatsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CommunicationsViewModel}">
                <views:CommunicationsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemViewModel}">
                <views:SystemView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FunctionEditorViewModel}">
                <views:FunctionEditorView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentsViewModel}">
                <views:ComponentsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentsInputViewModel}">
                <views:ComponentsInputView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DragDropTestViewModel}">
                <views:DragDropTestView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

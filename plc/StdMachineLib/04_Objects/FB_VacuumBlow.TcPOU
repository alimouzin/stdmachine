<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_VacuumBlow" Id="{af689a2b-a826-5964-b567-e3629d6090ce}" SpecialFunc="None">
    <Declaration><![CDATA[// Aspiration et soufflage, type 20 (docs/03 § 5.1).
// Capteur de vide : S3 pressostat (DI) ou S4 analogique. Hypothèse (à confirmer) : l'entrée analogique donne le vide
// en dixièmes de kPa (valeur brute ÷ 10).
FUNCTION_BLOCK FB_VacuumBlow EXTENDS FB_ObjectBase
VAR
    _bSuck : BOOL;
    _bBlow : BOOL;
    _bHasBlow : BOOL;
    _bDigital : BOOL;               // pressostat S3
    _bAnalog : BOOL;                // capteur S4
    _fVacuum : LREAL;               // kPa (négatif), ou 0/1 pour le pressostat
    _bPresent : BOOL;
    _bEmptyNozzle : BOOL;           // vide sous le seuil « buse vide »
    _bHolding : BOOL;               // pièce prise : une perte de vide est une erreur 101
    _bWaitVacuum : BOOL;
    _fBlowMs : LREAL;
    _fElapsed : LREAL;
    _fSimVacuum : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_OnConfigure" Id="{f5d18f8c-7cca-5909-8c1e-8c72f06aa162}">
      <Declaration><![CDATA[METHOD PROTECTED _OnConfigure : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bHasBlow := F_SignalValid(_refCfg.aSignal[2], E_SignalKind.DO);
_bDigital := F_SignalValid(_refCfg.aSignal[3], E_SignalKind.DI);
_bAnalog := F_SignalValid(_refCfg.aSignal[4], E_SignalKind.AI);
_bHolding := FALSE;
_OnConfigure := F_SignalValid(_refCfg.aSignal[1], E_SignalKind.DO) AND (_bDigital OR _bAnalog);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_DefaultTimeoutMs" Id="{d2a01893-4771-5f9a-b5fb-f66266445ca0}">
      <Declaration><![CDATA[METHOD PROTECTED _DefaultTimeoutMs : UDINT
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nAction = GVL_Catalog.VacuumBlow_Souffler THEN
    _DefaultTimeoutMs := LREAL_TO_UDINT(_ParamReal(1, _refCfg.aParam[3])) + 500;
ELSE
    _DefaultTimeoutMs := SUPER^._DefaultTimeoutMs(nAction);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnStart" Id="{887fcbf2-9c3f-518c-8380-629ccd6b8146}">
      <Declaration><![CDATA[METHOD PROTECTED _OnStart : E_ActStatus
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fElapsed := 0;
CASE nAction OF
    GVL_Catalog.VacuumBlow_Aspirer:
        _bBlow := FALSE;
        _bSuck := TRUE;
        _bWaitVacuum := _ParamReal(1, 1.0) >= 0.5;
        IF NOT _bWaitVacuum THEN
            _SetResult(1, BOOL_TO_LREAL(_bPresent));
            _OnStart := E_ActStatus.Done;
        ELSE
            _OnStart := E_ActStatus.Busy;
        END_IF
    GVL_Catalog.VacuumBlow_Souffler:
        _bSuck := FALSE;
        _bHolding := FALSE;
        _fBlowMs := MAX(_ParamReal(1, _refCfg.aParam[3]), 0.0);
        _bBlow := _bHasBlow;
        _OnStart := E_ActStatus.Busy;
    GVL_Catalog.VacuumBlow_Couper:
        _bSuck := FALSE;
        _bBlow := FALSE;
        _bHolding := FALSE;
        _OnStart := E_ActStatus.Done;
    GVL_Catalog.VacuumBlow_VerifierPresencePiece:
        _SetResult(1, BOOL_TO_LREAL(_bPresent));
        _OnStart := E_ActStatus.Done;
ELSE
    _OnStart := E_ActStatus.Error;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnCycle" Id="{853b86a7-9ded-5f38-93af-ea54b0d6f7f1}">
      <Declaration><![CDATA[METHOD PROTECTED _OnCycle : E_ActStatus
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fElapsed := _fElapsed + F_CycleMs();
CASE nAction OF
    GVL_Catalog.VacuumBlow_Aspirer:
        IF _bPresent THEN
            _bHolding := TRUE;
            _SetResult(1, 1.0);
            _OnCycle := E_ActStatus.Done;
        ELSIF _nTimeoutMs > 0 AND _fElapsed + F_CycleMs() >= UDINT_TO_LREAL(_nTimeoutMs) THEN
            _Fail(GVL_Catalog.VacuumBlow_Err100, 0);        // vide non atteint, avant le timeout générique
            _OnCycle := E_ActStatus.Error;
        ELSE
            _OnCycle := E_ActStatus.Busy;
        END_IF
    GVL_Catalog.VacuumBlow_Souffler:
        IF _fElapsed >= _fBlowMs THEN
            _bBlow := FALSE;
            _OnCycle := E_ActStatus.Done;
        ELSE
            _OnCycle := E_ActStatus.Busy;
        END_IF
ELSE
    _OnCycle := E_ActStatus.Done;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OnAbort" Id="{4e261836-ad09-53e0-acef-301dd57d9afe}">
      <Declaration><![CDATA[METHOD PROTECTED _OnAbort
VAR_INPUT
    nAction : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bBlow := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SafeState" Id="{ba7df9a8-4110-52dc-928e-24ecb3ba1d70}">
      <Declaration><![CDATA[METHOD PROTECTED _SafeState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bBlow := FALSE;
IF _refCfg.aParam[4] = 0 THEN
    _bSuck := FALSE;                // tout couper
    _bHolding := FALSE;
END_IF                              // 1 : maintenir l'aspiration
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Monitor" Id="{893fa06c-eefd-52c4-9d0c-71e88a9b1735}">
      <Declaration><![CDATA[METHOD PROTECTED _Monitor
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _bAnalog AND _refCfg.aParam[1] >= _refCfg.aParam[2] THEN
    IF _eState <> E_ObjState.Error THEN _Fail(GVL_Catalog.VacuumBlow_Err102, 0); END_IF
    RETURN;
END_IF
IF _bHolding AND _bSuck AND NOT _bPresent AND _eState <> E_ObjState.Error THEN
    _bHolding := FALSE;
    _Fail(GVL_Catalog.VacuumBlow_Err101, 0);       // pièce tombée
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReadHw" Id="{dfefb487-5259-528f-90e2-12edfe32b93f}">
      <Declaration><![CDATA[METHOD PROTECTED _ReadHw
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _bDigital THEN
    _bPresent := F_ReadDI(_refCfg.aSignal[3]);
    _fVacuum := BOOL_TO_LREAL(_bPresent);
ELSE
    _fVacuum := INT_TO_LREAL(F_ReadAI(_refCfg.aSignal[4])) / 10.0;
    _Evaluate();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Simulate" Id="{525e71df-641d-5353-98ed-6e5d5d07c148}">
      <Declaration><![CDATA[METHOD PROTECTED _Simulate
VAR
    fStep : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Vide simulé : −70 kPa en 80 ms quand on aspire, retour à 0 sinon
fStep := 70.0 * F_CycleMs() / 80.0;
IF _bSuck THEN _fSimVacuum := MAX(-70.0, _fSimVacuum - fStep); ELSE _fSimVacuum := MIN(0.0, _fSimVacuum + fStep); END_IF
IF _Forced(4) THEN _fSimVacuum := _ForcedValue(4); END_IF
IF _bDigital THEN
    _bPresent := _fSimVacuum <= -60.0;
    IF _Forced(3) THEN _bPresent := _ForcedValue(3) >= 0.5; END_IF
    _fVacuum := BOOL_TO_LREAL(_bPresent);
ELSE
    _fVacuum := _fSimVacuum;
    _Evaluate();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Evaluate" Id="{c62e9c8c-471e-52f9-88ba-7ee33373788b}">
      <Declaration><![CDATA[METHOD PRIVATE _Evaluate
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Hystérésis entre P1 (pièce présente, −60 kPa) et P2 (buse vide, −52 kPa)
IF _fVacuum <= _refCfg.aParam[1] THEN
    _bPresent := TRUE;
ELSIF _fVacuum >= _refCfg.aParam[2] THEN
    _bPresent := FALSE;
END_IF
_bEmptyNozzle := _fVacuum >= _refCfg.aParam[2];
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_WriteHw" Id="{80b90cb8-9b9e-56c6-9b8f-9a97e21d49b8}">
      <Declaration><![CDATA[METHOD PROTECTED _WriteHw
]]></Declaration>
      <Implementation>
        <ST><![CDATA[F_WriteDO(_refCfg.aSignal[1], _bSuck AND NOT _bBlow);     // jamais les deux ensemble
IF _bHasBlow THEN F_WriteDO(_refCfg.aSignal[2], _bBlow AND NOT _bSuck); END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Publish" Id="{aadb0db8-1773-51de-9c49-338aaee4a055}">
      <Declaration><![CDATA[METHOD PROTECTED _Publish
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stStatus.aValue[1] := BOOL_TO_LREAL(_bSuck);
_stStatus.aValue[2] := BOOL_TO_LREAL(_bBlow);
_stStatus.aValue[3] := _fVacuum;
_stStatus.aValue[4] := BOOL_TO_LREAL(_bPresent);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows : net48 comme le reste du PoC. Ailleurs (CI, session Linux) : net8.0 qui compile les sources de Core par lien. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>StdMachine.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\..\src\StdMachine.Core\StdMachine.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Compile Include="..\..\src\StdMachine.Core\**\*.cs" Exclude="..\..\src\StdMachine.Core\obj\**;..\..\src\StdMachine.Core\bin\**" LinkBase="Core" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\catalog\catalog.json" Link="catalog\catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<UserControl x:Class="StdMachine.Hmi.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Exporter en CSV" c:Ui.Icon="download" Command="{Binding ExportCsvCommand}"
                    Visibility="{Binding TabIndex, Converter={x:Static infra:Conv.PositiveToVis}}"/>
            <TextBlock Text="Alarmes" Style="{StaticResource Type.PageTitle}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="16,4,0,0"/>
        </DockPanel>

        <ListBox Grid.Row="1" Style="{StaticResource Tabs}" SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
            <ListBoxItem Content="Actives"/>
            <ListBoxItem Content="Historique"/>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,12,0,12">
            <c:TextField DockPanel.Dock="Right" Width="320" Text="{Binding Search, Mode=TwoWay}" Placeholder="Rechercher dans les alarmes" Label="Rechercher"/>
            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Filters}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding Filter, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource PageCard}" Padding="0">
            <Grid>
                <c:EmptyState IconName="check_circle" Title="Aucune alarme" Message="Rien à signaler avec ces filtres."
                              Visibility="{Binding IsEmpty, Converter={x:Static infra:Conv.BoolToVis}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="68" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Divider}" BorderThickness="0,0,0,1" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding Tone, Converter={x:Static infra:Conv.ToneDot}}"/>
                                        <c:Icon Grid.Column="1" Glyph="{Binding Icon}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Tone, Converter={x:Static infra:Conv.ToneDot}}"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource TableCellMuted}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Code}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Where}" Style="{StaticResource TableCell}" FontWeight="Medium" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource TableCellMuted}"/>
                                        </StackPanel>
                                        <c:StatusPill Grid.Column="6" Text="{Binding StateText}" Tone="{Binding Tone}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Button Content="Aller à" c:Ui.Icon="arrow_forward" Height="44" MinHeight="44" Margin="0,0,8,0" Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanGoTo, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                            <Button Content="Acquitter" c:Ui.Variant="Primary" Height="44" MinHeight="44" Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanAcknowledge, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

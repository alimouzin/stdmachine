<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_MoverStatus" Id="{d51b9872-a03a-5789-ae43-78bccddddf2c}">
    <Declaration><![CDATA[// Statut d'un mover (docs/06 § 6.3)
{attribute 'pack_mode' := '1'}
TYPE ST_MoverStatus :
STRUCT
    eState : E_MoverState;
    eWait : E_WaitReason;
    fX : REAL;
    fY : REAL;
    fC : REAL;
    nStation : USINT;
    nDest : INT;
    nTargetGroup : USINT;
    nTable : INT;
    nPC : INT;
    nStepId : UDINT;
    bOutOfService : BOOL;
    bQualityLock : BOOL;
    bAbsent : BOOL;
    aSlot : ARRAY[1..GVL_Const.MAX_SLOTS] OF ST_SlotStatus;
    aVar : ARRAY[1..GVL_Const.MAX_MOVER_VARS] OF LREAL;
    aVarPos : ARRAY[1..GVL_Const.MAX_MOVER_VARS] OF ST_Position;
    aVarId : ARRAY[1..GVL_Const.MAX_MOVER_VARS] OF UDINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

<UserControl x:Class="StdMachine.Hmi.Controls.StationChipBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure">
    <!-- Rangée de puces de stations (48 px, avec point d'état) ; DataContext = liste de StationChipViewModel -->
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
        <ItemsControl ItemsSource="{Binding}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding SelectCommand}" Height="44" MinHeight="44" Margin="0,0,8,0" Padding="16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" CornerRadius="22" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" Padding="16,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <c:StatusDot x:Name="Dot" Tone="{Binding Tone}" Margin="0,0,8,0" Pulse="{Binding Blink}"/>
                                                    <TextBlock x:Name="Txt" Text="{Binding Name}" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent.Bg}"/>
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Accent.Text}"/>
                                                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.Sunken}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

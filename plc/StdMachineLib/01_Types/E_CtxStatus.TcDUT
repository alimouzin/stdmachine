<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_CtxStatus" Id="{4263d7b5-79c7-5fb2-88a5-b84c73968d59}">
    <Declaration><![CDATA[// Statut d'un contexte d'exécution (docs/05 § 3.1)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_CtxStatus :
(
    Free := 0,
    Running := 1,
    WaitAction := 2,
    WaitCond := 3,
    WaitTime := 4,
    WaitJoin := 5,
    WaitStep := 6,
    Holding := 7,
    Done := 8,
    Failed := 9
) USINT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

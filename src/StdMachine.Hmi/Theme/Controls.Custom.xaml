<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
                    xmlns:res="clr-namespace:StdMachine.Hmi.Resources">

    <!-- ====== Touches du pavé numérique et du clavier ====== -->
    <Style x:Key="KeyButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Size.Keypad.Key}"/>
        <Setter Property="Height" Value="{StaticResource Size.Keypad.Key}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.L}" Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="IconText" Text="{Binding Path=(c:Ui.IconChar), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icons}" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.IconChar" Value="">
                            <Setter TargetName="IconText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.Sunken}"/>
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="c:Ui.Variant" Value="Primary">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.OnColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KeyButtonAlt" TargetType="Button" BasedOn="{StaticResource KeyButton}">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="{StaticResource Bg.Sunken}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.L}" Background="{StaticResource Bg.Sunken}"
                            BorderBrush="{StaticResource Border.Default}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="IconText" Text="{Binding Path=(c:Ui.IconChar), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icons}" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.IconChar" Value="">
                            <Setter TargetName="IconText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Border.Default}"/>
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== StatusPill ====== -->
    <Style TargetType="c:StatusPill">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StatusPill">
                    <Border Background="{TemplateBinding ToneBg}" CornerRadius="12" Padding="10,0" Height="24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Ico" Text="{TemplateBinding IconChar}" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                                       Foreground="{TemplateBinding ToneText}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Text}" FontSize="13" FontWeight="Medium" Foreground="{TemplateBinding ToneText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconChar" Value="">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== StateBadge ====== -->
    <Style TargetType="c:StateBadge">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StateBadge">
                    <Border Background="{TemplateBinding Back}" BorderBrush="{TemplateBinding Edge}" BorderThickness="1.5"
                            CornerRadius="{TemplateBinding BadgeCorner}" Padding="12,0,14,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="PART_Stripes" Visibility="Collapsed" Margin="-12,0,-14,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PART_Icon" Text="{TemplateBinding IconChar}" FontFamily="{StaticResource Font.Icons}"
                                           FontSize="{TemplateBinding IconSize}" Foreground="{TemplateBinding Fore}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Label}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Foreground="{TemplateBinding Fore}"/>
                                    <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" FontSize="12" Foreground="{TemplateBinding Fore}" Opacity="0.85" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDescription" Value="True">
                            <Setter TargetName="Desc" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== OverrideControl ====== -->
    <Style TargetType="c:OverrideControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:OverrideControl">
                    <Border x:Name="Root" Height="{StaticResource Size.Touch}" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.M}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <TextBlock x:Name="ZeroLabel" Text="{TemplateBinding ZeroText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Warn.Text}"
                                       VerticalAlignment="Center" Margin="14,0,6,0" Visibility="Collapsed"/>
                            <Button x:Name="PART_Minus" c:Ui.Icon="remove" c:Ui.Variant="Ghost" Width="48" Height="46" MinWidth="48" MinHeight="46"/>
                            <Button x:Name="PART_Value" c:Ui.Variant="Ghost" MinWidth="76" Height="46" MinHeight="46" Padding="0" FontSize="20" FontWeight="SemiBold"
                                    Content="{TemplateBinding Display}"/>
                            <Button x:Name="PART_Plus" c:Ui.Icon="add" c:Ui.Variant="Ghost" Width="48" Height="46" MinWidth="48" MinHeight="46"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsZero" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Warn.Bg}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Warn.Dot}"/>
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ZeroLabel" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== Champs numérique et texte ====== -->
    <Style TargetType="c:NumberField">
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NumberField">
                    <Border x:Name="Root" MinHeight="{StaticResource Size.Touch}" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.M}" Padding="14,0">
                        <DockPanel VerticalAlignment="Center" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Unit}" Style="{StaticResource Type.Caption}" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Display}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent.Bg}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Err.Dot}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Err.Bg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.Sunken}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:TextField">
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:TextField">
                    <Border x:Name="Root" MinHeight="{StaticResource Size.Touch}" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.M}" Padding="14,0">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Shown}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPlaceholder" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent.Bg}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Err.Dot}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Err.Bg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== EmptyState ====== -->
    <Style TargetType="c:EmptyState">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="{TemplateBinding IconChar}" FontFamily="{StaticResource Font.Icons}" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Text.Disabled}"/>
                        <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Type.Title}" HorizontalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Type.Body}" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="ActionButton" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}" c:Ui.Variant="Primary"
                                HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="160"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActionText" Value="{x:Null}">
                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== LockOverlay ====== -->
    <Style TargetType="c:LockOverlay">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:LockOverlay">
                    <Border Background="#D9FFFFFF" CornerRadius="{StaticResource Radius.M}">
                        <Border Background="{StaticResource Neutral.Bg}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
                                CornerRadius="18" Padding="14,0" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:Icon Glyph="lock" FontSize="18" Foreground="{StaticResource Neutral.Text}" Margin="0,0,6,0"/>
                                <TextBlock Text="{TemplateBinding Message}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Neutral.Text}"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== HoldButton : anneau qui se remplit pendant l'appui ====== -->
    <Style TargetType="c:HoldButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="{StaticResource Size.Command}"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:HoldButton">
                    <Border x:Name="Root" CornerRadius="{StaticResource Radius.M}" Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" Padding="16,0" SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                <c:ProgressRing RingSize="40" Value="{Binding HoldProgress, RelativeSource={RelativeSource TemplatedParent}}"
                                                StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <TextBlock Text="{Binding Path=(c:Ui.IconChar), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource Font.Icons}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <ContentPresenter RecognizesAccessKey="False"/>
                                <TextBlock Text="{res:T Common.HoldOneSecond}" FontSize="12" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Variant" Value="Primary">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.OnColor}"/>
                        </Trigger>
                        <Trigger Property="c:Ui.Variant" Value="Danger">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Err.Dot}"/>
                            <Setter Property="Foreground" Value="{StaticResource Err.Text}"/>
                        </Trigger>
                        <Trigger Property="IsHolding" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.Sunken}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.Sunken}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Border.Divider}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

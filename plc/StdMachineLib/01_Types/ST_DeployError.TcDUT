TYPE ST_DeployError :
STRUCT
    nCode : UINT;                   // voir FB_Loader
    nStation : USINT;               // 0 = machine
    nTable : USINT;
    nInstr : INT;
    nObject : UINT;
    nDetail : UDINT;
END_STRUCT
END_TYPE
]]></Declaration>

<UserControl x:Class="StdMachine.Hmi.Views.ForcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StdMachine.Hmi.Controls"
             xmlns:infra="clr-namespace:StdMachine.Hmi.Infrastructure"
             Background="{StaticResource Bg.App}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Text="Forçages et états déclarés" Style="{StaticResource Type.PageTitle}" Margin="0,0,0,12"/>

            <!-- État déclaré -->
            <Border Style="{StaticResource PageCard}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14" MinHeight="44">
                        <Button DockPanel.Dock="Right" Content="Lever" Command="{Binding LiftDeclaredCommand}" Visibility="{Binding HasDeclared, Converter={x:Static infra:Conv.BoolToVis}}" c:Ui.Icon="lock_open"/>
                        <c:StatusDot Tone="Maint" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding HasDeclared, Converter={x:Static infra:Conv.BoolToVis}}"/>
                        <TextBlock Text="{Binding DeclaredText}" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="B" Height="72" Margin="0,0,10,10" Command="{Binding DataContext.SetDeclaredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Glyph="{Binding Icon}" FontSize="28" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <c:Icon Glyph="lock" FontSize="18" Foreground="{StaticResource Text.Tertiary}" Margin="10,0,0,0" Visibility="{Binding Blocks, Converter={x:Static infra:Conv.BoolToVis}}"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="B" Property="c:Ui.Variant" Value="Primary"/><Setter TargetName="B" Property="Background" Value="{StaticResource Maint.Dot}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Les états marqués d'un cadenas bloquent le démarrage de la machine tant qu'ils sont déclarés." Style="{StaticResource Type.Caption}"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="640"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PageCard}" Padding="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Stations" Style="{StaticResource SectionTitle}" Margin="16,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Stations}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Height="72">
                                        <DockPanel Margin="16,0">
                                            <Button DockPanel.Dock="Right" Command="{Binding DataContext.ToggleStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="48" MinHeight="48" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="Hors production"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutOfProduction}" Value="True">
                                                                <Setter Property="Content" Value="Remettre en production"/>
                                                                <Setter Property="c:Ui.Variant" Value="Primary"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <c:StateBadge DockPanel.Dock="Left" State="{Binding State}" Size="Medium" VerticalAlignment="Center" Width="140" HorizontalAlignment="Left"/>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource TableCellMuted}"/>
                                                <TextBlock Text="{Binding ModeText}" Style="{StaticResource TableCellMuted}" Visibility="{Binding ModeText, Converter={x:Static infra:Conv.NotEmptyToVis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Text="Movers" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Movers}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="B" Height="88" Margin="0,0,8,8" Command="{Binding DataContext.ToggleMoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <c:Icon x:Name="Ico" Glyph="crop_square" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center"><Run Text="Mover "/><Run Text="{Binding Number, Mode=OneWay}"/></TextBlock>
                                            <TextBlock x:Name="Sub" Text="En service" Style="{StaticResource TableCellMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding OutOfService}" Value="True">
                                            <Setter TargetName="Ico" Property="Glyph" Value="build"/>
                                            <Setter TargetName="Sub" Property="Text" Value="Hors service"/>
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource Maint.Bg}"/>
                                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Maint.Dot}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Toucher un mover pour le mettre hors service ou le remettre en service." Style="{StaticResource Type.Caption}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Forçages actifs -->
            <Border Style="{StaticResource PageCard}" Padding="0,14,0,0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding EntriesTitle}" Style="{StaticResource SectionTitle}" Margin="16,0,0,8"/>
                    <TextBlock Text="Aucun forçage actif." Style="{StaticResource Type.Caption}" Margin="16,0,0,16" Visibility="{Binding HasEntries, Converter={x:Static infra:Conv.InvBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}" Height="60">
                                    <DockPanel Margin="16,0">
                                        <c:HoldButton DockPanel.Dock="Right" Content="Lever" c:Ui.Icon="lock_open" Width="150" Height="48" Command="{Binding DataContext.LiftEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="15">
                                            <Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Description, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Reason, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Since, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding By, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Until, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Essais -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <TextBlock Text="Essais (simulateur seulement)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Imposer un état à une station, injecter un défaut sur un objet ou imposer des résultats : disponible quand le simulateur est connecté (phase 4). Cette page est une maquette alimentée par des données de démonstration." Style="{StaticResource Type.Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

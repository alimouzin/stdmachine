<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:display="clr-namespace:Hmi.Display">

    <!-- Thème sobre, pensé pour un écran tactile : grandes cibles, aucun effet de survol nécessaire. -->

    <Color x:Key="BackgroundColor">#F2F4F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="NavColor">#1F2A37</Color>
    <Color x:Key="AccentColor">#2B6CB0</Color>
    <Color x:Key="DangerColor">#C0392B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="NavBrush" Color="{StaticResource NavColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD2D9"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2933"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#616E7C"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#E4E7EB"/>

    <display:StateToBrushConverter x:Key="StateBrush"/>
    <display:StateToLabelConverter x:Key="StateLabel"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <!-- Bouton tactile : 64 px de haut minimum. -->
    <Style x:Key="TouchButton" TargetType="Button">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DisabledBrush}"/>
                            <Setter Property="Foreground" Value="#9AA5B1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
        <Setter Property="Background" Value="#52606D"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Carte blanche -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="6"/>
    </Style>

    <!-- Liste à grands éléments -->
    <Style TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- Balise : pastille ronde colorée -->
    <Style x:Key="Beacon" TargetType="Ellipse">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Stroke" Value="#33000000"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>
</ResourceDictionary>

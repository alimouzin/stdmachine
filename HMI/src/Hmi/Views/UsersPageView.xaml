<UserControl x:Class="Hmi.Views.UsersPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Utilisateurs et droits" Style="{StaticResource TitleText}"/>
            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" MinHeight="26"/>

            <!-- Niveau requis par type d'action -->
            <TextBlock Text="Niveau requis par type d'action" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Rights}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" DisplayMemberPath="Name"
                                          SelectedValuePath="Rank" SelectedValue="{Binding RequiredRank, Mode=TwoWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Niveaux -->
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Niveaux" Style="{StaticResource SectionText}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Rank}" Width="40" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding LevelName, UpdateSourceTrigger=PropertyChanged}" Margin="4,10,4,4"/>
                            <WrapPanel>
                                <Button Content="Ajouter" Command="{Binding AddLevelCommand}" Style="{StaticResource TouchButton}"/>
                                <Button Content="Renommer" Command="{Binding RenameLevelCommand}" Style="{StaticResource TouchButton}"/>
                                <Button Content="Supprimer" Command="{Binding RemoveLevelCommand}" Style="{StaticResource DangerButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Utilisateurs -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Utilisateurs" Style="{StaticResource SectionText}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Width="180" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LevelName}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="4,10,4,0"/>
                            <TextBox Text="{Binding UserPin, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding NewUserLevel, Mode=TwoWay}"/>
                            <TextBlock Text="Nom, PIN et niveau pour un nouvel utilisateur ; le niveau choisi sert aussi à « Changer niveau »."
                                       Style="{StaticResource MutedText}" FontSize="14" Margin="4,0,0,4"/>
                            <WrapPanel>
                                <Button Content="Ajouter" Command="{Binding AddUserCommand}" Style="{StaticResource TouchButton}"/>
                                <Button Content="Changer niveau" Command="{Binding ChangeUserLevelCommand}" Style="{StaticResource TouchButton}"/>
                                <Button Content="Supprimer" Command="{Binding RemoveUserCommand}" Style="{StaticResource DangerButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

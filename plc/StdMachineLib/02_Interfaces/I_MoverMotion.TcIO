<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <Itf Name="I_MoverMotion" Id="{29cad2ab-c9c8-52eb-9f96-915ddcd8523c}">
    <Declaration><![CDATA[// Mouvement d'un mover hors process (mode manuel, docs/05 § 6.5) : le gestionnaire de movers tient l'occupation
// à jour. Donnée aux objets Mover par GVL_IoRef.ipMovers.
INTERFACE I_MoverMotion
]]></Declaration>
    <Method Name="MoveFree" Id="{55f7ebe6-1171-5a3c-9bff-6a8e2bb2e55a}">
      <Declaration><![CDATA[// Déplacement vers une position quelconque du plan ; fSpeedPct en % de la vitesse par défaut des movers
METHOD MoveFree : BOOL
VAR_INPUT
    nMover : USINT;
    stPos : ST_Position;
    fSpeedPct : LREAL;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="StopMover" Id="{40b9104d-fa7d-58eb-83ad-24d18e39d98b}">
      <Declaration><![CDATA[METHOD StopMover
VAR_INPUT
    nMover : USINT;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="Moving" Id="{975fd306-7b73-5c74-b71a-277dc38e1218}">
      <Declaration><![CDATA[METHOD Moving : BOOL
VAR_INPUT
    nMover : USINT;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="Position" Id="{2829e580-e512-5182-b3a7-393176fe8872}">
      <Declaration><![CDATA[METHOD Position : ST_Position
VAR_INPUT
    nMover : USINT;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>

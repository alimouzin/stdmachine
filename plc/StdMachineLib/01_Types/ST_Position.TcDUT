<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_Position" Id="{cc51799b-50a1-50b6-8823-de7705b0b30b}">
    <Declaration><![CDATA[// Toujours X, Y, Z, C + frame (docs/04 § 5). Le frame n'est exploité que par un robot Stäubli (D86).
{attribute 'pack_mode' := '1'}
TYPE ST_Position :
STRUCT
    fX : LREAL;                 // mm
    fY : LREAL;                 // mm
    fZ : LREAL;                 // mm
    fC : LREAL;                 // degrés
    nFrame : INT;               // 0 = repère machine ou repère des axes
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_QualityTrack" Id="{4d198e3a-633c-59e6-9cb8-fda41fac0f18}">
    <Declaration><![CDATA[// État d'une instance de portée qualité (docs/10 § 9)
{attribute 'pack_mode' := '1'}
TYPE ST_QualityTrack :
STRUCT
    nConsec : USINT;
    aWindow : ARRAY[0..31] OF BYTE;     // 256 résultats en bits (1 = mauvais)
    nHead : USINT;
    nCount : USINT;
    nBadInWindow : USINT;
    nProbationLeft : USINT;
    eLevel : E_QualityLevel;
    bLocked : BOOL;
    nTotalGood : UDINT;
    nTotalBad : UDINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
